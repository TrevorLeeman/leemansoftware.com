---
import { url } from '../url';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Stats from '../components/Stats.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import { limits } from '../exchange';
import { company, organizationRef, osrsPageViews, playerCount, scale } from '../site';

// Dates and counts are checked against the products' repos and live sites on 2026-10-04: OSRS
// Exchange's first commit is from July 2022, and the item counts are each live sitemap's item pages.
const record = [
  {
    title: 'OSRS Exchange',
    tag: `Since ${company.since}`,
    body: `Our first product, started in July ${company.since}. More than ${playerCount} players have used it since, and it tracks 4,500+ items.`,
    link: { label: 'About OSRS Exchange', href: url('/osrs-exchange') },
  },
  {
    title: 'RS3 Exchange',
    tag: 'Since 2026',
    body: 'In 2026 the platform was reworked to run two games from one codebase, each with its own items, tax rules and skills, and RS3 Exchange opened on it. It tracks 7,000+ items.',
    link: { label: 'About RS3 Exchange', href: url('/rs3-exchange') },
  },
  {
    title: 'Wallyt',
    tag: 'In testing',
    body: 'An app for splitting shared costs, built so one codebase runs on Android, iOS and the web. Android comes first: it’s in testing ahead of its Google Play launch.',
    link: { label: 'About Wallyt', href: url('/wallyt') },
  },
];

const principles = [
  { title: 'Your card stays with Stripe', body: 'Premium is billed by Stripe. Card details never reach our servers, and you cancel from your account settings.' },
  { title: 'Support from the source', body: 'Email and Discord messages come straight to us. We wrote the code, so the reply comes from somewhere that can fix the problem rather than file it.' },
  { title: 'Proven to work and scale', body: `More than 4,900 automated tests cover tax rules, payments, alerts and currency maths, and the systems behind them have carried more than ${playerCount} players and ${osrsPageViews} page views.` },
  { title: 'Numbers you can check', body: 'Prices come from the RuneScape Wiki’s public data, tax follows each game’s published rules, and Wallyt keeps the exchange rate with every expense it converts.' },
  { title: 'Infrastructure run in-house', body: 'Both Exchange sites run on servers we set up and maintain, behind Cloudflare, with errors reported as they happen.' },
  { title: 'Plain about limits', body: 'Each product’s page says what’s free, what isn’t and what it doesn’t do yet.' },
];

// What protects the people using the products if a product is ever wound down.
const safeguards = [
  { title: 'Your records leave with you', body: 'Wallyt exports any group as a CSV file that opens in any spreadsheet, whenever you like.' },
  { title: 'You’d be told first', body: 'Wallyt’s terms promise notice by email or in the app before it ever closes, so you can export your groups first.' },
  { title: 'You can stop paying at any time', body: 'Exchange Premium is cancelled from your account settings, and you keep it to the end of the period you’ve paid for.' },
];

const shipped = [
  { title: 'Payments and subscriptions', body: 'Stripe checkout with free trials, sales tax, renewals and cancelling, kept in step with what each account can use.' },
  { title: 'Sign-in and accounts', body: 'Emailed codes, Google One Tap and Android’s account sheet, Discord linking, and bot protection at sign-up.' },
  { title: 'Live data at scale', body: `Prices for 11,500+ items across two games, fetched around the clock, charted back years and watched by alerts every ${limits.alertCheck} seconds.` },
  { title: 'Apps for every screen', body: 'One React Native codebase for Android, iOS and the web, with end-to-end tests run on each.' },
  { title: 'Notifications people act on', body: 'A Discord bot and email delivery for price alerts, with retries and cooldowns handled.' },
  { title: 'Running it afterwards', body: 'Servers, deploys, error reporting and scheduled jobs, looked after by us long after launch.' },
];
---

<Base
  title={`About ${company.brand}`}
  description={`${company.brand} is an independent studio founded by ${company.founder} in ${company.since}. It builds and runs OSRS Exchange, RS3 Exchange and Wallyt, and takes on client work.`}
  pageType="AboutPage"
  schema={{ mainEntity: organizationRef }}
>
  <section class="intro wrap">
    <div class="intro-copy">
      <p class="label">about</p>
      <h1 class="title">An independent studio, proven on our own products.</h1>
      <p class="lede">
        {company.brand} was founded by {company.founder} in {company.since}.
        We started with OSRS Exchange, and we’ve designed, built and run everything here since, from the
        first sketch to the servers and the support inbox.
      </p>
    </div>
    <figure class="portrait">
      <img
        src={url('/about/trevor-leeman.webp')}
        alt={`${company.founder}, founder and developer of ${company.brand}`}
        width="600"
        height="750"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>
        <span>{company.founder}</span>
        <span>Founder</span>
      </figcaption>
    </figure>
  </section>

  <section id="record" class="wrap section" aria-labelledby="record-title">
    <SectionHead title="The record so far" id="record-title" />
    <Stats stats={scale} />
    <FeatureGrid features={record} />
  </section>

  <section id="how" class="wrap section" aria-labelledby="how-title">
    <SectionHead title="How the products are run" id="how-title" />
    <FeatureGrid features={principles} />
  </section>

  <section id="stop" class="wrap section" aria-labelledby="stop-title">
    <SectionHead title="Built so you’re never stuck" id="stop-title">
      Any product can be wound down one day. This is what protects you if that ever happens.
    </SectionHead>
    <FeatureGrid features={safeguards} />
  </section>

  <section id="work" class="wrap section" aria-labelledby="work-title">
    <SectionHead title="Work with us" id="work-title">
      We take on a few client projects a year. If you need a web app, an Android app, or the payments,
      sign-in and servers behind one, you work directly with the studio writing the code, from the first
      sketch to production. These are things we’ve built. Everything but Wallyt is live today.
    </SectionHead>
    <FeatureGrid features={shipped} />
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
    padding-block: clamp(56px, 9vw, 128px) 0;
  }

  .intro-copy {
    display: grid;
    gap: 20px;
  }

  .intro h1 {
    font-size: clamp(36px, 5.6vw, 72px);
  }

  .portrait {
    margin: 0;
  }

  .portrait img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--rule);
  }

  .portrait figcaption {
    display: grid;
    gap: 2px;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 500;
  }

  .portrait figcaption span:last-child {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 400;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .portrait {
      width: 240px;
      max-width: 100%;
    }
  }

  .section {
    padding-top: clamp(96px, 12vw, 160px);
  }
</style>
