---
import { url } from '../url';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Stats from '../components/Stats.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import { limits } from '../exchange';
import { company, email, organizationRef, playerCount, scale } from '../site';

// Dates and counts are checked against the products' repos and live sites on 2026-10-04: OSRS
// Exchange's first commit is from July 2022, and the item counts are each live sitemap's item pages.
const record = [
  {
    title: 'OSRS Exchange',
    tag: `Since ${company.since}`,
    body: `I started OSRS Exchange in July ${company.since}. More than ${playerCount} players have used it since, and it tracks 4,500+ items.`,
    link: { label: 'About OSRS Exchange', href: url('/osrs-exchange') },
  },
  {
    title: 'RS3 Exchange',
    tag: 'Since 2026',
    body: 'In 2026 I reworked the platform to run two games from one codebase, each with its own items, tax rules and skills, and opened RS3 Exchange on it. It tracks 7,000+ items.',
    link: { label: 'About RS3 Exchange', href: url('/rs3-exchange') },
  },
  {
    title: 'Wallyt',
    tag: 'In testing',
    body: 'An app for splitting shared costs, built so one codebase runs on Android, iOS and the web. Android comes first: it’s in testing ahead of its Google Play launch.',
    link: { label: 'About Wallyt', href: url('/wallyt') },
  },
];

const principles = [
  { title: 'Your card stays with Stripe', body: 'Premium is billed by Stripe. Card details never reach my servers, and you cancel from your account settings.' },
  { title: 'A person answers', body: 'Email and Discord messages come to me, the person who wrote the code, so the reply is from someone who can fix the problem.' },
  { title: 'Nothing ships untested', body: 'More than 4,900 automated tests cover tax rules, payments, alerts and currency maths. On the Exchange sites they run on every change before it goes live.' },
  { title: 'Numbers you can check', body: 'Prices come from the RuneScape Wiki’s public data, tax follows each game’s published rules, and Wallyt keeps the exchange rate with every expense it converts.' },
  { title: 'Servers I look after', body: 'Both Exchange sites run on servers I set up and maintain, behind Cloudflare, with errors reported to me as they happen.' },
  { title: 'Plain about limits', body: 'Each product’s page says what’s free, what isn’t and what it doesn’t do yet.' },
];

// What protects the people using the products if their one developer is ever not here.
const safeguards = [
  { title: 'Your records leave with you', body: 'Wallyt exports any group as a CSV file that opens in any spreadsheet, whenever you like.' },
  { title: 'You’d be told first', body: 'Wallyt’s terms promise notice by email or in the app before it ever closes, so you can export your groups first.' },
  { title: 'You can stop paying at any time', body: 'Exchange Premium is cancelled from your account settings, and you keep it to the end of the period you’ve paid for.' },
];

const shipped = [
  { title: 'Payments and subscriptions', body: 'Stripe checkout with free trials, sales tax, renewals and cancelling, kept in step with what each account can use.' },
  { title: 'Sign-in and accounts', body: 'Emailed codes, Google One Tap and Android’s account sheet, Discord linking, and bot protection at sign-up.' },
  { title: 'Live data at scale', body: `Prices for 11,500+ items across two games, fetched around the clock, charted back years and watched by alerts every ${limits.alertCheck} seconds.` },
  { title: 'Apps for every screen', body: 'One React Native codebase for Android, iOS and the web, with end-to-end tests run on each.' },
  { title: 'Notifications people act on', body: 'A Discord bot and email delivery for price alerts, with retries and cooldowns handled.' },
  { title: 'Running it afterwards', body: 'Servers, deploys, error reporting and scheduled jobs, looked after by the person who built the product.' },
];
---

<Base
  title={`About ${company.founder} and ${company.brand}`}
  description={`${company.founder} is the one developer behind ${company.brand}. He builds and runs OSRS Exchange, RS3 Exchange and Wallyt himself. How he works, and how to hire him.`}
  pageType="AboutPage"
  schema={{ mainEntity: organizationRef }}
>
  <section class="intro wrap">
    <p class="label">about</p>
    <h1 class="title">The person behind the products.</h1>
    <p class="lede">
      I’m {company.founder}. {company.brand} is my studio, the product studio of {company.legalName},
      and I’m its only developer. I started with OSRS Exchange in {company.since}, and I’ve designed, built
      and run everything here myself since, from the first sketch to the servers.
    </p>
  </section>

  <section id="record" class="wrap section" aria-labelledby="record-title">
    <SectionHead title="The record so far" id="record-title" />
    <Stats stats={scale} />
    <FeatureGrid features={record} />
  </section>

  <section id="how" class="wrap section" aria-labelledby="how-title">
    <SectionHead title="How I run them" id="how-title" />
    <FeatureGrid features={principles} />
  </section>

  <section id="stop" class="wrap section" aria-labelledby="stop-title">
    <SectionHead title="If I stop" id="stop-title">
      One developer is one point of failure. This is what protects you if I’m ever not here.
    </SectionHead>
    <FeatureGrid features={safeguards} />
  </section>

  <section id="work" class="wrap section" aria-labelledby="work-title">
    <SectionHead title="Work with me" id="work-title">
      I take on a few projects a year. If you need a web app, an Android app, or the payments, sign-in
      and servers behind one, you work directly with the person writing the code, from the first
      sketch to production. These are things I’ve built. Everything but Wallyt is live today.
    </SectionHead>
    <FeatureGrid features={shipped} />
    <p class="reach">
      <a class="mail" href={`mailto:${email}`}>{email}</a>
      <button class="copy" type="button" data-copy={email} aria-label={`Copy ${email}`}>Copy</button>
      <a href={url('/#integrations')}>The platforms these run on</a>
    </p>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: 20px;
    padding-block: clamp(56px, 9vw, 128px) 0;
  }

  .intro h1 {
    font-size: clamp(36px, 5.6vw, 72px);
  }

  .section {
    padding-top: clamp(96px, 12vw, 160px);
  }

  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin: clamp(32px, 4vw, 48px) 0 0;
  }

  .mail {
    font-family: var(--mono);
    font-size: clamp(17px, 1.8vw, 22px);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .reach a:last-child {
    margin-left: auto;
    font-size: 15px;
    font-weight: 500;
  }

  @media (max-width: 700px) {
    .reach a:last-child {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
