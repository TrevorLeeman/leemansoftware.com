---
import Base from '../layouts/Base.astro';
import { email, products } from '../site';

const host = (href: string) => new URL(href).hostname.replace(/^www\./, '');

// Rendered width of a screen, counting the page zoom big screens get (global.css).
const sizesFor = (featured?: boolean) => {
  const w = featured ? 1200 : 700;
  return [
    `(min-width: 3200px) ${w * 2}px`,
    `(min-width: 2400px) ${Math.round(w * 1.4)}px`,
    `(min-width: 2000px) ${Math.round(w * 1.25)}px`,
    `(max-width: 820px) 100vw`,
    `${w}px`,
  ].join(', ');
};
---

<Base description="Leeman Software is a small product studio. We make OSRS Exchange, RS3 Exchange and Wallyt.">
  <section class="hero wrap">
    <h1 class="title">
      Small, focused software<br /><span>for the web and Android.<i class="cursor" aria-hidden="true"></i></span>
    </h1>
  </section>

  <section id="products" class="wrap" aria-label="Products">
    {
      products.map((p, i) => {
        const linkProps = p.external ? { rel: 'noopener' } : {};
        return (
          <article class:list={['product', p.shot.frame, { featured: p.featured, flip: !p.featured && i % 2 === 0 }]} style={`--brand: ${p.color}`}>
            <div class="info">
              <div class="head">
                <img
                  class:list={['icon', { pixel: p.slug !== 'wallyt' }]}
                  src={p.icon}
                  alt=""
                  width="48"
                  height="48"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                <h2 class="name">
                  <a href={p.href} {...linkProps}>{p.name}</a>
                </h2>
              </div>
              <div class="about">
                <p class="summary">{p.summary}</p>
                <p class="meta">
                  <span class:list={['badge', p.status]}>{p.status === 'live' ? 'live' : 'coming soon'}</span>
                  <span>{p.platforms.toLowerCase()}</span>
                </p>
                <a class="go" href={p.href} {...linkProps}>
                  {p.external ? `Open ${host(p.href)}` : `About ${p.name}`}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {p.external ? <path d="M7 17 17 7M8 7h9v9" /> : <path d="M5 12h14M13 6l6 6-6 6" />}
                  </svg>
                </a>
              </div>
            </div>

            <a class="screen" href={p.shot.url ?? p.href} tabindex="-1" aria-hidden="true" {...linkProps}>
              {p.shot.frame === 'browser' && (
                <span class="chrome">
                  <i />
                  <i />
                  <i />
                  <span class="url">{p.shot.url ? p.shot.url.replace(/^https:\/\/(www\.)?/, '') : host(p.href)}</span>
                </span>
              )}
              <picture>
                {p.shot.dark && <source srcset={p.shot.dark} media="(prefers-color-scheme: dark)" />}
                <img
                  src={p.shot.src}
                  srcset={p.shot.small ? `${p.shot.small} 800w, ${p.shot.src} ${p.shot.width}w${p.shot.large ? `, ${p.shot.large} 2360w` : ''}` : undefined}
                  sizes={p.shot.small ? sizesFor(p.featured) : undefined}
                  width={p.shot.width}
                  height={p.shot.height}
                  alt={p.shot.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </picture>
            </a>
          </article>
        );
      })
    }
  </section>

  <section id="contact" class="wrap contact" aria-labelledby="contact-title">
    <h2 class="contact-title" id="contact-title">Get in touch</h2>
    <p class="addr">
      <a href={`mailto:${email}`}>{email}</a>
      <button class="copy" type="button" data-copy={email} aria-label={`Copy ${email}`}>Copy</button>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 96px) clamp(28px, 3.4vw, 48px);
  }

  .hero h1 {
    font-size: clamp(38px, 5.4vw, 76px);
  }

  .hero h1 span {
    color: var(--muted);
  }

  /* Each product: what it is beside a real screen from it. */
  .product {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding-block: clamp(48px, 6vw, 96px);
    border-top: 1px solid var(--rule);
  }

  .product.phone {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  /* Alternate sides down the page, screen first. */
  .product.flip .screen {
    order: -1;
  }

  .product.flip.phone {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .info,
  .about {
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  .info {
    gap: 16px;
  }

  .head {
    display: grid;
    justify-items: start;
    gap: 18px;
  }

  .icon {
    width: 48px;
    height: 48px;
    border-radius: 11px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .icon.pixel {
    image-rendering: pixelated;
  }

  .name {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .name a {
    text-decoration: none;
  }

  .summary {
    margin: 0;
    max-width: 32em;
    font-size: 17px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 2px 0 0;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  /* The featured product leads: its name on the left, what it does on the right, and its
     screen across the full width below. */
  .product.featured {
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 40px);
    padding-top: clamp(32px, 4vw, 56px);
  }

  .featured .info {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: end;
    gap: 20px clamp(32px, 5vw, 80px);
  }

  .featured .name {
    font-size: clamp(34px, 4.4vw, 60px);
  }

  .featured .summary {
    font-size: 18px;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .go svg {
    color: var(--brand);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .go:hover {
    text-decoration: underline;
    text-decoration-color: var(--brand);
  }

  .go:hover svg {
    transform: translateX(3px);
  }

  .browser .go:hover svg {
    transform: translate(2px, -2px);
  }

  .screen {
    display: block;
    text-decoration: none;
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .product:hover .screen {
    transform: translateY(-4px);
  }

  .screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Web products sit in a slim browser outline with their real address. */
  .browser .screen {
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: 12px;
    background: #0b0b0c;
    box-shadow: 0 40px 80px -50px color-mix(in srgb, var(--brand) 80%, transparent);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    background: #141416;
  }

  .chrome i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .url {
    flex: 1;
    margin-right: 39px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: rgb(255 255 255 / 0.55);
    text-align: center;
  }

  /* Wallyt sits in a plain phone outline. */
  .phone .screen {
    justify-self: center;
    width: min(100%, 280px);
    padding: 8px;
    border: 1px solid var(--rule-strong);
    border-radius: 38px;
    background: var(--surface);
    box-shadow: 0 40px 80px -48px color-mix(in srgb, var(--brand) 80%, transparent);
  }

  .phone .screen img {
    aspect-ratio: 390 / 600;
    border-radius: 30px;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 820px) {
    .product,
    .product.phone,
    .product.flip.phone {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .featured .info {
      grid-template-columns: 1fr;
    }

    .product.flip .screen {
      order: 0;
    }

    .phone .screen {
      width: min(100%, 300px);
    }
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: baseline;
    gap: 12px clamp(32px, 5vw, 80px);
    padding-block: clamp(48px, 6vw, 96px) 0;
    /* A rule as wide as the content, not the padded container. */
    background: linear-gradient(var(--rule), var(--rule)) center top / calc(100% - var(--gutter) * 2) 1px no-repeat;
  }

  .contact-title {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .addr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 0;
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  .addr a {
    font-family: var(--mono);
    font-size: clamp(20px, 3vw, 30px);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
</style>
