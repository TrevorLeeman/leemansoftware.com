---
import Base from '../layouts/Base.astro';
import { company, email, products } from '../site';

const live = products.filter((p) => p.status === 'live').length;
const soon = products.length - live;

const contacts = [
  { key: 'general', value: email.hello, note: 'Questions, partnerships and press' },
  { key: 'support', value: email.support, note: 'Help with Wallyt' },
  { key: 'privacy', value: email.privacy, note: 'Data and account deletion requests' },
];
---

<Base description="Leeman Software is a small product studio. We make Wallyt, OSRS Exchange and RS3 Exchange.">
  <section class="hero">
    <div class="wrap">
      <p class="badge live">{live} live · {soon} coming soon</p>
      <h1 class="title">Small, focused software<br /><span>for the web and Android.</span></h1>
      <p class="lede">
        {company.brand} builds and runs a handful of products: live market data for RuneScape
        players, and soon, an easier way to split shared costs with friends.
      </p>
      <div class="actions">
        <a class="button primary" href="#products">See products</a>
        <a class="button" href={`mailto:${email.hello}`}>Get in touch</a>
      </div>
    </div>
  </section>

  <section id="products" class="wrap section" aria-labelledby="products-title">
    <p class="label" id="products-title">products</p>
    <ul class="products">
      {
        products.map((p, i) => (
          <li>
            <a class="row" href={p.href} style={`--brand: ${p.color}`} {...(p.external ? { rel: 'noopener' } : {})}>
              <img
                class:list={['icon', { pixel: p.slug !== 'wallyt' }]}
                src={p.icon} alt=""
                width="52"
                height="52"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <span class="body">
                <span class="name-line">
                  <span class="name">{p.name}</span>
                  <span class:list={['badge', p.status]}>
                    {p.status === 'live' ? 'live' : 'coming soon'}
                  </span>
                </span>
                <span class="summary">{p.summary}</span>
                <span class="meta">
                  {p.platforms.toLowerCase()}
                  {p.external && <> · {new URL(p.href).hostname.replace(/^www\./, '')}</>}
                </span>
              </span>
              <span class="arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  {p.external ? <path d="M7 17 17 7M8 7h9v9" /> : <path d="M5 12h14M13 6l6 6-6 6" />}
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="about" class="wrap section" aria-labelledby="about-title">
    <p class="label" id="about-title">about</p>
    <div class="about">
      <h2 class="title">A few products, each one looked after properly.</h2>
      <div class="about-copy">
        <p>
          {company.brand} is the product studio of {company.legalName}. We started with OSRS
          Exchange, a live Grand Exchange tracker for Old School RuneScape, and brought the same
          engine to RuneScape 3 with RS3 Exchange.
        </p>
        <p>
          Wallyt is our first mobile app. It keeps track of shared costs for roommates, trips and
          couples, so nobody has to keep a spreadsheet or remember who paid last.
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="wrap section" aria-labelledby="contact-title">
    <p class="label" id="contact-title">contact</p>
    <dl class="contacts">
      {
        contacts.map((c) => (
          <div>
            <dt>{c.key}</dt>
            <dd>
              <span class="addr">
                <a href={`mailto:${c.value}`}>{c.value}</a>
                <button class="copy" type="button" data-copy={c.value} aria-label={`Copy ${c.value}`}>
                  Copy
                </button>
              </span>
              <span class="note">{c.note}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-block: clamp(64px, 11vw, 128px) clamp(48px, 6vw, 72px);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }

  /* A faint grid behind the hero, fading out toward the edges. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 80% 70% at 30% 20%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 30% 20%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero .wrap {
    position: relative;
  }

  .hero h1 {
    margin-top: 24px;
    font-size: clamp(40px, 6.6vw, 76px);
  }

  .hero h1 span {
    color: var(--muted);
  }

  .hero .lede {
    margin-top: 22px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .section {
    padding-top: clamp(56px, 8vw, 96px);
  }

  .products {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .products li + li {
    border-top: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 32px;
    align-items: start;
    gap: 20px;
    padding: 24px;
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  /* Each row warms to its product's own color on hover. */
  .row {
    position: relative;
  }

  .row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--brand);
    opacity: 0;
    transition: opacity 140ms ease;
  }

  .row:hover {
    background: color-mix(in srgb, var(--brand) 5%, transparent);
  }

  .row:hover::before {
    opacity: 1;
  }

  .icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .icon.pixel {
    image-rendering: pixelated;
  }

  .body {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .name-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }

  .name {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .summary {
    max-width: 44em;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .meta {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .arrow {
    align-self: center;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--muted);
    transition: color 140ms ease, border-color 140ms ease, transform 180ms ease;
  }

  .row:hover .arrow {
    color: var(--brand);
    border-color: color-mix(in srgb, var(--brand) 40%, var(--rule));
    transform: translateX(2px);
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 16px;
      padding: 20px 16px;
    }

    .icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
    }

    .arrow {
      display: none;
    }
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 6vw, 80px);
    margin-top: 16px;
  }

  .about h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.12;
  }

  .about-copy p {
    margin: 0 0 1em;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  .contacts {
    margin: 16px 0 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .contacts > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 4px 20px;
    padding: 16px 20px;
  }

  .contacts > div + div {
    border-top: 1px solid var(--rule);
  }

  .contacts dt {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
  }

  .contacts dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
    margin: 0;
  }

  .contacts dd a {
    font-family: var(--mono);
    font-size: 14.5px;
    overflow-wrap: anywhere;
  }

  .addr {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .note {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .contacts > div {
      grid-template-columns: 1fr;
      padding: 14px 16px;
    }
  }
</style>
