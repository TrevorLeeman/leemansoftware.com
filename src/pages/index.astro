---
import Base from '../layouts/Base.astro';
import Product from '../components/Product.astro';
import { email, products } from '../site';
---

<Base
  description="We design, build and run web and Android apps: OSRS Exchange and RS3 Exchange, used by 364,000+ RuneScape traders, and Wallyt for splitting shared costs."
>
  <section class="intro wrap">
    <h1 class="title">
      Small, focused software <span>for the web and Android.<i class="cursor" aria-hidden="true"></i></span>
    </h1>
    <p class="lede">
      We design, build and run our own products, end to end: live market tools used by 364,000+
      RuneScape traders, and Wallyt, an app for splitting shared costs.
    </p>
  </section>

  <section id="products" class="products wrap" aria-label="Products">
    {products.map((p, i) => <Product product={p} flip={i % 2 === 1} eager={i === 0} />)}
  </section>

  <section id="contact" class="contact wrap" aria-labelledby="contact-title">
    <h2 class="title" id="contact-title">Work with us</h2>
    <p class="lede">
      We take on a few projects a year: web apps, Android apps and the backends behind them, from the
      first sketch to launch.
    </p>
    <p class="addr">
      <a href={`mailto:${email}`}>{email}</a>
      <button class="copy" type="button" data-copy={email} aria-label={`Copy ${email}`}>Copy</button>
    </p>
  </section>
</Base>

<style>
  /* The intro stands alone, centred, with the products well below it. */
  .intro {
    display: grid;
    justify-items: center;
    gap: 24px;
    padding-block: clamp(64px, 12vw, 160px) clamp(56px, 9vw, 128px);
    text-align: center;
  }

  .intro h1 {
    font-size: clamp(38px, 6.2vw, 84px);
  }

  .intro h1 span {
    display: block;
    color: var(--muted);
  }

  .intro .lede {
    max-width: 34em;
  }

  /* One row per product, the same for each, alternating sides. */
  .products {
    display: grid;
    gap: clamp(88px, 10vw, 152px);
  }

  .contact {
    display: grid;
    justify-items: center;
    gap: 20px;
    padding-top: clamp(112px, 14vw, 200px);
    text-align: center;
  }

  .contact h2 {
    font-size: clamp(34px, 4.4vw, 60px);
  }

  .contact .lede {
    max-width: 30em;
  }

  .addr {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 14px;
    margin: 8px 0 0;
  }

  /* Phones read the whole page down one left edge, like the stacked products. */
  @media (max-width: 899px) {
    .intro,
    .contact {
      justify-items: start;
      text-align: left;
    }

    .addr {
      justify-content: start;
    }
  }

  .addr a {
    font-family: var(--mono);
    font-size: clamp(18px, 2vw, 26px);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
</style>
