---
import Base from '../layouts/Base.astro';
import { company, email, products } from '../site';
---

<Base description="Leeman Software is a small product studio. We make Wallyt, OSRS Exchange and RS3 Exchange.">
  <section class="hero wrap">
    <p class="eyebrow">Product studio</p>
    <h1 class="display">Small software,<br /><em>made with care.</em></h1>
    <p class="lede">
      We make a handful of focused products and keep improving them: live market data for
      RuneScape players, and soon, an easier way to split what you share with friends.
    </p>
  </section>

  <section id="products" class="products wrap" aria-labelledby="products-title">
    <div class="section-head">
      <p class="eyebrow" id="products-title">Products</p>
      <p class="count">{products.length} products</p>
    </div>

    <ol class="list">
      {
        products.map((p, i) => (
          <li>
            <a
              class="row"
              href={p.href}
              {...(p.external ? { rel: 'noopener' } : {})}
            >
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <img
                class:list={['icon', { pixel: p.slug !== 'wallyt' }]}
                src={p.icon}
                alt=""
                width="72"
                height="72"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <span class="body">
                <span class="name-line">
                  <span class="name">{p.name}</span>
                  <span class:list={['status', p.status]}>
                    {p.status === 'live' ? 'Live' : 'Coming soon'}
                  </span>
                </span>
                <span class="summary">{p.summary}</span>
                <span class="meta">
                  {p.platforms}
                  {p.external && <span class="host"> · {new URL(p.href).hostname.replace(/^www\./, '')}</span>}
                </span>
              </span>
              <span class="arrow" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  {p.external ? <path d="M7 17 17 7M8 7h9v9" /> : <path d="M5 12h14M13 6l6 6-6 6" />}
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="about" class="about wrap" aria-labelledby="about-title">
    <p class="eyebrow" id="about-title">About</p>
    <div class="about-grid">
      <p class="statement display">
        Fewer products, each one looked after properly.
      </p>
      <div class="about-copy">
        <p>
          {company.brand} is the product studio of {company.legalName}. We started with OSRS Exchange,
          a live Grand Exchange tracker for Old School RuneScape, and brought the same engine to
          RuneScape 3 with RS3 Exchange.
        </p>
        <p>
          Wallyt is our first mobile app. It keeps track of shared costs for roommates, trips and
          couples, so nobody has to keep a spreadsheet or remember who paid last.
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="contact wrap" aria-labelledby="contact-title">
    <p class="eyebrow" id="contact-title">Contact</p>
    <h2 class="display">Say hello.</h2>
    <div class="contact-grid">
      <div>
        <p class="label">General and press</p>
        <a class="mail" href={`mailto:${email.hello}`}>{email.hello}</a>
      </div>
      <div>
        <p class="label">Help with Wallyt</p>
        <a class="mail" href={`mailto:${email.support}`}>{email.support}</a>
      </div>
      <div>
        <p class="label">Privacy requests</p>
        <a class="mail" href={`mailto:${email.privacy}`}>{email.privacy}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(64px, 12vw, 148px) clamp(56px, 9vw, 112px);
  }

  .hero h1 {
    margin-top: 22px;
    font-size: clamp(54px, 10.5vw, 132px);
  }

  .hero h1 em {
    color: var(--muted);
  }

  .hero .lede {
    margin-top: clamp(24px, 3vw, 36px);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--ink);
  }

  .count {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    border-bottom: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 44px 72px minmax(0, 1fr) 40px;
    align-items: start;
    gap: clamp(16px, 2.6vw, 32px);
    padding-block: clamp(24px, 3.4vw, 40px);
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  .index {
    padding-top: 10px;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .icon {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent), 0 10px 24px -14px rgb(0 0 0 / 0.35);
  }

  .icon.pixel {
    image-rendering: pixelated;
  }

  .body {
    display: grid;
    gap: 8px;
  }

  .name-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .name {
    font-family: var(--serif);
    font-size: clamp(32px, 4.2vw, 46px);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .status {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .status.live {
    color: var(--ink-soft);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .status.live::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 7px;
    vertical-align: 1px;
    border-radius: 50%;
    background: #3f8f5a;
  }

  .status.soon {
    color: var(--brass);
    background: var(--brass-soft);
  }

  .summary {
    max-width: 40em;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .meta {
    font-size: 13px;
    color: var(--muted);
  }

  .arrow {
    justify-self: end;
    align-self: center;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition: transform 220ms ease, color 200ms ease, background-color 200ms ease, box-shadow 200ms ease;
  }

  .row:hover .arrow {
    color: var(--paper);
    background: var(--ink);
    box-shadow: none;
    transform: translateX(3px);
  }

  .row:hover .name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 56px minmax(0, 1fr);
      align-items: start;
      gap: 16px;
    }

    .index,
    .arrow {
      display: none;
    }

    .icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
    }
  }

  .about {
    padding-top: clamp(96px, 13vw, 160px);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }

  .statement {
    font-size: clamp(36px, 4.6vw, 58px);
    line-height: 1.06;
  }

  .about-copy p {
    margin: 0 0 1em;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact {
    padding-top: clamp(96px, 13vw, 160px);
  }

  .contact h2 {
    margin-top: 18px;
    font-size: clamp(44px, 7vw, 84px);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }

  .label {
    margin: 0 0 6px;
    font-size: 13px;
    color: var(--muted);
  }

  .mail {
    font-size: 17px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
