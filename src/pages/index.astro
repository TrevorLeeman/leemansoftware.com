---
import Base from '../layouts/Base.astro';
import Product from '../components/Product.astro';
import { email, products } from '../site';

const featured = products.find((p) => p.featured)!;
const rest = products.filter((p) => !p.featured);
---

<Base description="Leeman Software is a small product studio. We make OSRS Exchange, RS3 Exchange and Wallyt.">
  <section class="landing wrap">
    <div class="intro">
      <h1 class="title">
        Small, focused software <span>for the web and Android.<i class="cursor" aria-hidden="true"></i></span>
      </h1>
      <nav class="index" aria-label="Products">
        <p class="label">products</p>
        <ol>
          {
            products.map((p) => (
              <li style={`--brand: ${p.color}`}>
                <a href={`#${p.slug}`}>
                  <img class:list={{ pixel: p.slug !== 'wallyt' }} src={p.icon} alt="" width="28" height="28" />
                  <span class="index-name">{p.name}</span>
                  <span class:list={['badge', p.status]}>{p.status === 'live' ? 'live' : 'soon'}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div id="contact" class="contact">
        <p class="label">contact</p>
        <p class="addr">
          <a href={`mailto:${email}`}>{email}</a>
          <button class="copy" type="button" data-copy={email} aria-label={`Copy ${email}`}>Copy</button>
        </p>
      </div>
    </div>
    <Product product={featured} eager sizes="(min-width: 3000px) 1760px, (min-width: 1100px) 62vw, 100vw" />
  </section>

  <section class="more wrap" aria-label="More products">
    {rest.map((p) => <Product product={p} sizes="(min-width: 3000px) 1100px, (min-width: 1100px) 50vw, 100vw" />)}
  </section>
</Base>

<style>
  /* First screen: the studio on the left, its flagship product on the right. */
  .landing {
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    padding-block: clamp(28px, 4vw, 64px) clamp(48px, 5vw, 80px);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .intro h1 {
    font-size: clamp(36px, 8.4vw, 64px);
  }

  .intro h1 span {
    color: var(--muted);
  }

  .index ol {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .index li {
    border-bottom: 1px solid var(--rule);
  }

  .index a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-block: 10px;
    text-decoration: none;
  }

  .index img {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .index img.pixel {
    image-rendering: pixelated;
  }

  .index-name {
    flex: 1;
    font-weight: 500;
  }

  .index a:hover .index-name {
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-underline-offset: 0.22em;
  }

  /* On phones the products follow straight after, so the index is only for wider screens. */
  .index {
    display: none;
  }

  .addr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 6px 0 0;
  }

  .addr a {
    font-family: var(--mono);
    font-size: 15px;
    overflow-wrap: anywhere;
  }

  @media (min-width: 1100px) {
    .landing {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: stretch;
      column-gap: clamp(48px, 4.5vw, 112px);
    }

    .intro {
      gap: clamp(36px, 4vw, 64px);
      padding-block: 4px;
    }

    /* The contact settles at the bottom, level with the end of the chart. */
    .contact {
      margin-top: auto;
    }

    .intro h1 {
      font-size: clamp(40px, 2.6vw, 60px);
    }

    .index {
      display: block;
    }
  }

  /* Second screen: the other products side by side. */
  .more {
    display: grid;
    gap: clamp(56px, 6vw, 96px);
    padding-top: clamp(48px, 5vw, 80px);
    background: linear-gradient(var(--rule), var(--rule)) center top / calc(100% - var(--gutter) * 2) 1px no-repeat;
  }

  /* Each remaining product gets its own row: what it is on the left, its screen on the right. */
  .more > :global(.product + .product) {
    padding-top: clamp(56px, 6vw, 96px);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 1100px) {
    .more > :global(.product) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: none;
      align-items: center;
      column-gap: clamp(48px, 4.5vw, 112px);
    }

    .more > :global(.product.phone .screen) {
      justify-self: center;
    }
  }
</style>
