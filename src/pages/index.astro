---
import Base from '../layouts/Base.astro';
import { company, email, products } from '../site';

const live = products.filter((p) => p.status === 'live').length;
const soon = products.length - live;

const contacts = [
  { key: 'general', value: email.hello, note: 'Questions, partnerships and press' },
  { key: 'support', value: email.support, note: 'Help with Wallyt' },
  { key: 'privacy', value: email.privacy, note: 'Data and account deletion requests' },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base description="Leeman Software is a small product studio. We make Wallyt, OSRS Exchange and RS3 Exchange.">
  <section class="hero">
    <div class="wrap">
      <p class="badge live">{live} live · {soon} coming soon</p>
      <h1 class="title">
        Small, focused software<br /><span>for the web and Android.<i class="cursor" aria-hidden="true"></i></span>
      </h1>
      <p class="lede">
        {company.brand} builds and runs a handful of products: live market data for RuneScape
        players, and soon, an easier way to split shared costs with friends.
      </p>
      <div class="actions">
        <a class="button primary" href="#products">See products</a>
        <a class="button" href={`mailto:${email.hello}`}>Get in touch</a>
      </div>
    </div>
  </section>

  <section id="products" class="wrap section" aria-labelledby="products-title">
    <div class="section-head">
      <p class="label" id="products-title">products</p>
      <span class="count">{pad(products.length)}</span>
    </div>
    <ol class="products">
      {
        products.map((p, i) => (
          <li style={`--brand: ${p.color}`}>
            <a class="row" href={p.href} {...(p.external ? { rel: 'noopener' } : {})}>
              <span class="index">{pad(i + 1)}</span>
              <img
                class:list={['icon', { pixel: p.slug !== 'wallyt' }]}
                src={p.icon}
                alt=""
                width="56"
                height="56"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <span class="body">
                <span class="name-line">
                  <span class="name">{p.name}</span>
                  <span class:list={['badge', p.status]}>
                    {p.status === 'live' ? 'live' : 'coming soon'}
                  </span>
                </span>
                <span class="summary">{p.summary}</span>
              </span>
              <span class="where">
                <span class="meta">
                  {p.external ? new URL(p.href).hostname.replace(/^www\./, '') : p.href}
                </span>
                <span class="meta platform">{p.platforms.toLowerCase()}</span>
              </span>
              <svg class:list={['arrow', { out: p.external }]} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {p.external ? <path d="M7 17 17 7M8 7h9v9" /> : <path d="M5 12h14M13 6l6 6-6 6" />}
              </svg>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="about" class="wrap section" aria-labelledby="about-title">
    <div class="section-head">
      <p class="label" id="about-title">about</p>
    </div>
    <div class="about">
      <h2 class="title">A few products, each one looked after properly.</h2>
      <div class="about-copy">
        <p>
          {company.brand} is the product studio of {company.legalName}. We started with OSRS
          Exchange, a live Grand Exchange tracker for Old School RuneScape, and brought the same
          engine to RuneScape 3 with RS3 Exchange.
        </p>
        <p>
          Wallyt is our first mobile app. It keeps track of shared costs for roommates, trips and
          couples, so nobody has to keep a spreadsheet or remember who paid last.
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="wrap section" aria-labelledby="contact-title">
    <div class="section-head">
      <p class="label" id="contact-title">contact</p>
    </div>
    <dl class="contacts">
      {
        contacts.map((c) => (
          <div>
            <dt>{c.key}</dt>
            <dd class="addr">
              <a href={`mailto:${c.value}`}>{c.value}</a>
              <button class="copy" type="button" data-copy={c.value} aria-label={`Copy ${c.value}`}>
                Copy
              </button>
            </dd>
            <dd class="note">{c.note}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-block: clamp(64px, 11vw, 128px) clamp(48px, 6vw, 72px);
    overflow: hidden;
  }

  /* A faint grid behind the hero, fading out toward the edges. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 80% 70% at 30% 20%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 30% 20%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero .wrap {
    position: relative;
  }

  .hero h1 {
    margin-top: 24px;
    font-size: clamp(40px, 6.6vw, 76px);
  }

  .hero h1 span {
    color: var(--muted);
  }

  .hero .lede {
    margin-top: 22px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .section {
    padding-top: clamp(56px, 8vw, 96px);
  }

  .products {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .products li {
    position: relative;
    border-bottom: 1px solid var(--rule);
  }

  /* A tick in the product's own color grows beside the row being pointed at. */
  .products li::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--gutter) * -0.6);
    width: 3px;
    height: 0;
    border-radius: 2px;
    background: var(--brand);
    transform: translateY(-50%);
    transition: height 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .products li:hover::before,
  .products li:focus-within::before {
    height: 44px;
  }

  .row {
    display: grid;
    grid-template-columns: 28px 56px minmax(0, 1fr) auto 18px;
    align-items: center;
    gap: clamp(14px, 2.4vw, 28px);
    padding-block: 28px;
    text-decoration: none;
  }

  .index {
    align-self: start;
    padding-top: 4px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .icon {
    width: 56px;
    height: 56px;
    border-radius: 13px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 220ms ease;
  }

  .row:hover .icon {
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent),
      0 12px 24px -12px var(--brand);
  }

  .icon.pixel {
    image-rendering: pixelated;
  }

  .body {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .name-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }

  .name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 140ms ease;
  }

  .row:hover .name {
    text-decoration-color: currentColor;
  }

  .summary {
    max-width: 40em;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .where {
    display: grid;
    justify-items: end;
    gap: 2px;
    text-align: right;
  }

  .meta {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
    transition: color 140ms ease;
  }

  .row:hover .where .meta:first-child {
    color: var(--ink);
  }

  .arrow {
    color: var(--muted);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1), color 140ms ease;
  }

  .row:hover .arrow {
    color: var(--brand);
    transform: translateX(3px);
  }

  .row:hover .arrow.out {
    transform: translate(2px, -2px);
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 56px minmax(0, 1fr) 18px;
    }

    .index {
      display: none;
    }

    .where {
      grid-column: 2;
      grid-row: 2;
      grid-auto-flow: column;
      justify-content: start;
      gap: 12px;
      text-align: left;
    }

    .arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 44px minmax(0, 1fr);
      align-items: start;
      gap: 8px 16px;
      padding-block: 22px;
    }

    .icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
    }

    .arrow {
      display: none;
    }

    .products li::before {
      left: calc(var(--gutter) * -1 + 3px);
    }
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 6vw, 80px);
    padding-top: 28px;
  }

  .about h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.12;
  }

  .about-copy p {
    margin: 0 0 1em;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  .contacts {
    margin: 0;
  }

  .contacts > div {
    display: grid;
    grid-template-columns: 120px auto minmax(0, 1fr);
    align-items: center;
    gap: 4px 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--rule);
  }

  .contacts dt {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .contacts dd {
    margin: 0;
  }

  .addr {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .addr a {
    font-family: var(--mono);
    font-size: 15px;
    overflow-wrap: anywhere;
  }

  .note {
    justify-self: end;
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .contacts > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .note {
      justify-self: start;
    }
  }
</style>
