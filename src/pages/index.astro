---
import { url } from '../url';
import Base from '../layouts/Base.astro';
import Product from '../components/Product.astro';
import SectionHead from '../components/SectionHead.astro';
import StudioReach from '../components/StudioReach.astro';
import Stats from '../components/Stats.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Questions from '../components/Questions.astro';
import { exchange } from '../exchange';
import { company, email, integrations, osrsPageViews, playerCount, players, products, scale, studioQuestions } from '../site';

// The home page opens on what the studio builds and runs, proves it with the products, then
// answers what a visitor checking on a product or a charge wants to know: who runs it, how money and
// data are handled, and the questions they came with. It speaks as the studio (“we”), never as one person.

// Local brand assets keep the connected-services section free of third-party requests.
const serviceIcons: Record<string, string> = {
  Stripe: 'stripe.svg',
  Google: 'google.svg',
  Discord: 'discord.svg',
  'RuneScape Wiki': 'runescape-wiki.png',
  WeirdGloop: 'weird-gloop.png',
  'Amazon SES and Postmark': 'amazon-ses.svg',
  Cloudflare: 'cloudflare.svg',
  Frankfurter: 'frankfurter.ico',
  Sentry: 'sentry.svg',
};

// One player's words sit under OSRS Exchange, the product they were said about.
const quotes: Record<string, ReturnType<typeof exchange>['quotes'][number]> = {
  'osrs-exchange': exchange('osrs-exchange').quotes[0],
};

// What the studio builds, as the capabilities behind the products on this page.
const capabilities = [
  { title: 'Live data at scale', body: `Prices for ${scale[1].value} items across two games, fetched around the clock, charted back years and watched by alerts every few seconds.` },
  { title: 'Payments and subscriptions', body: 'Stripe checkout with free trials, sales tax, renewals and cancelling, kept in step with what each account can use.' },
  { title: 'Sign-in and accounts', body: 'Emailed codes, Google sign-in on the web and on Android, Discord linking, and bot protection at sign-up.' },
  { title: 'Apps for every screen', body: 'Web apps, and one React Native codebase for Android, iOS and the web, with end-to-end tests run on each.' },
];

// How the products are run, from the user's side. Checked against the products' repos and policies
// on 2026-10-04; the about page has the longer version.
const trust = [
  {
    title: 'Your card stays with Stripe',
    body: 'Premium is billed by Stripe, and card details never reach our servers. Cancel from your account settings and you keep Premium to the end of the period you paid for.',
  },
  {
    title: 'Prices you can check yourself',
    body: 'Every price on the Exchange sites comes from the OSRS Wiki’s or the RuneScape Wiki’s public real-time data, and every margin follows each game’s published tax rules. Wallyt keeps the exchange rate with every expense it converts.',
  },
  {
    title: 'Nothing touches your game account',
    body: 'The Exchange sites never ask for your RuneScape login. Recipe levels come from Jagex’s public hiscores, from the name you type. Neither site is affiliated with Jagex.',
  },
  {
    title: 'Proven to work and scale',
    body: `More than ${scale[3].value.replace('+', '')} automated tests cover tax rules, payments, alerts and currency maths, and the systems behind them have carried more than ${playerCount} players and ${osrsPageViews} page views.`,
  },
  {
    title: 'Infrastructure we run',
    body: 'Both Exchange sites run on servers we set up and maintain, behind Cloudflare, with errors reported the moment they happen so they can be fixed quickly.',
  },
  {
    title: 'You can always leave',
    body: 'Premium is cancelled from your account settings, in a click. Wallyt exports any group as a CSV file, and its terms promise notice before it ever closes, so your records go with you.',
  },
];
---

<Base
  description={`Leeman Software is an independent studio that designs, builds and runs web and mobile products: OSRS Exchange, used by ${players} players, RS3 Exchange, Wallyt.`}
  questions={studioQuestions}
>
  <section class="intro wrap">
    <div class="intro-copy">
      <p class="label">independent software studio · since {company.since}</p>
      <h1 class="title">Products people rely on.<br /><span class="impact">Built and run to last.<i class="cursor" aria-hidden="true"></i></span></h1>
      <p class="lede">{company.brand} designs, builds and runs web and mobile products: live market data, payments and subscriptions, sign-in, alerts and the servers underneath. Our own products have served more than {playerCount} players since {company.since}, and we take on a few client projects a year.</p>
      <div class="intro-links"><a class="button primary" href="#products">See the products <span aria-hidden="true">↓</span></a><a href={url('/about#work')}>Work with us <span aria-hidden="true">↗</span></a></div>
    </div>
    <StudioReach />
  </section>

  <section id="products" class="products wrap" aria-label="Products">
    <div class="chapter"><p class="label">01 / the products</p><span>Built for real life. And a couple of virtual worlds.</span></div>
    {products.map((p, i) => <Product product={p} quote={quotes[p.slug]} flip={i % 2 === 1} eager={i === 0} />)}
  </section>

  <section id="studio" class="wrap section" aria-labelledby="studio-title">
    <p class="label chapter-label">02 / the studio</p>
    <div class="studio-head">
      <SectionHead title={`Independent since ${company.since}.`} id="studio-title">
        Everything on this page is designed, built and run in-house: the code, the servers, the billing
        and the support. Nothing is handed off, so support comes from the same place as the code, and
        a fix ships rather than a ticket.
      </SectionHead>
      <a class="portrait" href={url('/about')}>
        <img src={url('/about/trevor-leeman.webp')} alt={`${company.founder}, founder of ${company.brand}`} width="96" height="96" loading="lazy" />
        <span><strong>{company.founder}</strong><small>Founder · About the studio <span aria-hidden="true">↗</span></small></span>
      </a>
    </div>
    <Stats stats={scale} />
    <ol class="timeline">
      <li><span class="year">July {company.since}</span><span class="milestone" aria-hidden="true"></span><img src={products[0].icon} width="32" height="32" alt="" loading="lazy" /><h3>OSRS Exchange</h3><p>Our first product: a better way to see what’s worth trading in Old School RuneScape. More than {playerCount} players have used it since, and it has shipped every release in between.</p><a href={products[0].href}>About OSRS Exchange <span aria-hidden="true">↗</span></a></li>
      <li><span class="year">2026</span><span class="milestone" aria-hidden="true"></span><img src={products[1].icon} width="32" height="32" alt="" loading="lazy" /><h3>RS3 Exchange</h3><p>The platform was rebuilt to run two games from one codebase, each with its own items, tax rules and skills, and RS3 Exchange opened on it. One Premium covers both.</p><a href={products[1].href}>About RS3 Exchange <span aria-hidden="true">↗</span></a></li>
      <li><span class="year">Next · in testing</span><span class="milestone hollow" aria-hidden="true"></span><img src={products[2].icon} width="32" height="32" alt="" loading="lazy" /><h3>Wallyt</h3><p>The same engineering, pointed at shared expenses: rent, trips and dinners, exact to the cent in 161 currencies. Android comes first.</p><a href={products[2].href}>About Wallyt <span aria-hidden="true">↗</span></a></li>
    </ol>
  </section>

  <section id="capabilities" class="wrap section" aria-labelledby="capabilities-title">
    <p class="label chapter-label">03 / what we build</p>
    <SectionHead title="The hard parts, already in production." id="capabilities-title">
      The products on this page run on the same capabilities a client project needs. Everything here
      is live today and has been for years.
    </SectionHead>
    <FeatureGrid features={capabilities} />
  </section>

  <section id="trust" class="wrap section" aria-labelledby="trust-title">
    <p class="label chapter-label">04 / how the products are run</p>
    <SectionHead title="Money, data and uptime, handled the same way everywhere." id="trust-title">
      Whatever you use, this is how your card, your data and the service itself are looked after.
    </SectionHead>
    <FeatureGrid features={trust} />
  </section>

  <section id="integrations" class="wrap section" aria-labelledby="integrations-title">
    <p class="label chapter-label">05 / who handles what</p>
    <SectionHead title="Built on services you already use." id="integrations-title">
      Cards, email delivery and exchange rates aren’t improvised in-house. Each goes to a service whose
      whole business it is, and the products connect them. Open one to see where it fits.
    </SectionHead>
    <div class="services">{integrations.map((service) => <details><summary><span class="service-icon" data-service={service.title} aria-hidden="true"><img src={url(`/services/${serviceIcons[service.title]}`)} alt="" width="24" height="24" loading="lazy" decoding="async" /></span><span>{service.title}</span><span class="expand" aria-hidden="true">+</span></summary><p>{service.body}</p></details>)}</div>
  </section>

  <section id="questions" class="wrap section" aria-labelledby="questions-title">
    <p class="label chapter-label">06 / questions</p>
    <SectionHead title="Questions people ask" id="questions-title" />
    <Questions questions={studioQuestions} />
  </section>

  <section id="contact" class="contact wrap" aria-labelledby="contact-title">
    <a class="contact-portrait" href={url('/about')} aria-label={`Meet ${company.founder}, founder of ${company.brand}`}><img src={url('/about/trevor-leeman.webp')} alt="" width="72" height="72" loading="lazy" /></a>
    <p class="label">need something built?</p>
    <h2 class="title" id="contact-title">Let’s build something that lasts.</h2>
    <p class="lede">
      We take on a few client projects a year: web apps, Android apps, and the payments, sign-in and
      servers behind them. You work directly with the studio that builds and runs everything on this
      page, from the first sketch to production and the years after. <a href={url('/about#work')}>How we work</a>
    </p>
    <p class="addr">
      <a href={`mailto:${email}`}>{email}</a>
      <button class="copy" type="button" data-copy={email} aria-label={`Copy ${email}`}>Copy</button>
    </p>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(36px, 5vw, 80px); padding-block: clamp(56px, 8vw, 112px) clamp(72px, 10vw, 144px); }
  /* Compact the opening on laptop-sized viewports and smaller screens. */
  @media (max-width: 1728px) { .intro { padding-block-start: clamp(32px, 4vw, 64px); } }
  .intro-copy { display: grid; justify-items: start; gap: 26px; }
  .intro h1 { font-size: clamp(40px, 4.4vw, 64px); letter-spacing: -.055em; line-height: 1.04; }
  .impact { color: var(--muted); }
  .intro .lede { max-width: 30em; font-size: 17px; }
  .intro .label { font-size: 11px; }
  .intro-links { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; font-size: 13px; }
  .intro-links .button { height: 44px; gap: 20px; }
  .products { display: grid; gap: clamp(72px, 9vw, 128px); }
  .chapter { display: flex; justify-content: space-between; gap: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--rule-strong); margin-bottom: -32px; }
  .chapter span { font-size: 12px; color: var(--muted); }
  .chapter-label { margin-bottom: 22px; font-size: 11px; }
  .section { padding-top: clamp(88px, 11vw, 160px); }
  /* The section's heading and the studio's founder, side by side. */
  .studio-head { display: flex; justify-content: space-between; align-items: start; gap: 40px; }
  .studio-head :global(.head .intro) { max-width: 40em; }
  .portrait { display: flex; flex: none; align-items: center; gap: 16px; padding: 14px 18px 14px 14px; border: 1px solid var(--rule); border-radius: 999px; background: var(--surface); text-decoration: none; }
  .portrait img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: center 25%; }
  .portrait strong { display: block; font-size: 14px; font-weight: 550; }
  .portrait small { display: block; font: 11px var(--mono); color: var(--muted); }
  .portrait small span { color: var(--accent); }
  .portrait:hover { border-color: var(--rule-strong); }
  .timeline { display: grid; grid-template-columns: repeat(3, 1fr); padding: 0; margin: 8px 0 0; list-style: none; }
  .timeline li { position: relative; padding-right: 36px; display: flex; flex-direction: column; align-items: start; }
  .year { font: 11px var(--mono); color: var(--muted); margin-bottom: 22px; }
  .milestone { position: relative; display: block; width: calc(100% + 36px); height: 1px; background: var(--rule-strong); margin-bottom: 32px; }
  .milestone::before { content: ''; position: absolute; left: 0; top: -4px; width: 9px; height: 9px; border: 2px solid var(--accent); border-radius: 50%; background: var(--accent); }
  .hollow::before { background: var(--bg); }
  .timeline img { border-radius: 8px; }
  .timeline h3 { margin: 16px 0 8px; font-size: 20px; font-weight: 550; letter-spacing: -.025em; }
  .timeline p { margin: 0 0 20px; font-size: 14px; color: var(--ink-soft); }
  .timeline a { font-size: 12px; margin-top: auto; }
  .timeline a span { color: var(--accent); }
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; align-items: start; }
  .services details { border: 1px solid var(--rule); border-radius: 9px; background: var(--surface); }
  .services summary { list-style: none; display: flex; align-items: center; gap: 12px; padding: 18px; cursor: pointer; font-size: 13px; }
  .services summary::-webkit-details-marker { display: none; }
  .service-icon { display: grid; place-items: center; flex: 0 0 38px; height: 38px; border-radius: 7px; background: #1b1b20; border: 1px solid #303036; }
  .service-icon img { width: 24px; height: 24px; object-fit: contain; }
  /* Keep the tiles dark; lift individual marks without changing multicolor logos. */
  .service-icon[data-service='Stripe'] img,
  .service-icon[data-service='Discord'] img,
  .service-icon[data-service='Sentry'] img { filter: brightness(1.6) saturate(.8); }
  .service-icon[data-service='Amazon SES and Postmark'] img { filter: brightness(1.3); }
  .service-icon[data-service='WeirdGloop'] img { filter: brightness(1.5); }
  .service-icon[data-service='Frankfurter'] img { filter: invert(1); }
  .expand { margin-left: auto; color: var(--muted); }
  details[open] .expand { transform: rotate(45deg); }
  details[open] { border-color: var(--rule-strong); }
  .services p { margin: 0; padding: 0 18px 20px; font-size: 13px; color: var(--ink-soft); }
  .contact { display: grid; justify-items: center; gap: 20px; margin-top: clamp(88px, 11vw, 160px); padding-top: 64px; border-top: 1px solid var(--rule); text-align: center; }
  .contact-portrait img { width: 72px; height: 72px; object-fit: cover; object-position: center 25%; border-radius: 50%; box-shadow: 0 0 0 1px var(--rule); }
  .contact h2 { font-size: clamp(34px, 4.4vw, 60px); }
  .contact .lede { max-width: 36em; font-size: 16px; }
  .addr { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px 14px; margin: 8px 0 0; }
  .addr a { font-family: var(--mono); font-size: clamp(17px, 2vw, 26px); letter-spacing: -.02em; overflow-wrap: anywhere; }
  @media (max-width: 899px) { .intro { grid-template-columns: 1fr; } .intro-copy { max-width: 560px; } .intro h1 { font-size: clamp(36px, 7.5vw, 64px); } .intro :global(.reach) { width: 100%; max-width: 620px; } .services { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .studio-head { flex-direction: column; gap: 0; } .portrait { margin-bottom: 36px; } }
  @media (max-width: 600px) { .chapter { flex-direction: column; gap: 8px; } .timeline { grid-template-columns: 1fr; gap: 32px; } .timeline li { padding-left: 24px; padding-right: 0; border-left: 1px solid var(--rule-strong); } .milestone { position: absolute; top: 9px; left: -5px; width: 9px; background: none; } .year { margin-bottom: 16px; } .services { grid-template-columns: 1fr; } .contact { text-align: left; justify-items: start; } .addr { justify-content: start; } }
</style>
