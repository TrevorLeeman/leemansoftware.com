---
import Exchange from '../../layouts/Exchange.astro';
import { product } from '../../site';

// Facts checked against the osrs-exchange repo and www.osrs.exchange on 2026-10-04. When the site changes, change them here.
---

<Exchange
  product={product('osrs-exchange')}
  title="Live OSRS Grand Exchange prices and margins"
  description="Free live Grand Exchange prices for Old School RuneScape: margins after tax, price history, recipe profit and price alerts for every tradeable item."
  lede="OSRS Exchange is a free website with live Grand Exchange prices for Old School RuneScape. Players use it to find items worth flipping, see what recipes make, and check how any item’s price has moved."
  features={[
    { title: 'Live margins', href: 'https://www.osrs.exchange/', body: 'Every tradeable item in one table: buy and sell price, profit after tax, volume and buy limit.' },
    { title: 'Price history', body: 'A page and chart for every item, from the last few minutes back through years of trading.' },
    { title: 'Recipe profit', href: 'https://www.osrs.exchange/recipes', body: 'What every recipe makes at today’s prices, from skilling to set making.' },
    { title: 'Price alerts', href: 'https://www.osrs.exchange/alerts', body: 'A Discord message or email the moment an item hits your price.' },
  ]}
  stats={[
    { value: '364,000+', label: 'traders' },
    { value: '4,500+', label: 'item pages' },
    { value: '4,000+', label: 'recipes priced live' },
    { value: '6 s', label: 'between price updates on Premium' },
  ]}
  built={[
    { title: 'Prices as they trade', body: 'Live prices come from the RuneScape Wiki’s real-time feed the moment it refreshes, and every margin, profit and chart updates with them.' },
    { title: 'Official price history', body: 'WeirdGloop’s archive of official Grand Exchange prices is backfilled for every item, and five years of daily prices are kept.' },
    { title: 'One platform, two games', body: 'OSRS Exchange and RS3 Exchange run on one codebase and one server, each with its own game’s items, tax rules and features.' },
    { title: 'Premium through Stripe', body: 'Checkout, sales tax, renewals and cancelling all run through Stripe, and one subscription covers both sites.' },
    { title: 'Alerts on Discord and email', body: 'Alerts are checked every 6 seconds and sent by a Discord bot’s direct message or by email, whichever you choose.' },
    { title: 'Sign in your way', body: 'Make an account with email or Google, and link Discord for alerts and the Premium role in our server.' },
  ]}
  trust={[
    { title: 'Public data', body: 'Prices come from the RuneScape Wiki’s real-time data, the source the community already relies on.' },
    { title: 'Tax included', body: 'Every profit is after the Grand Exchange’s 2% tax, with its 50 gp floor, 5M cap and exempt items.' },
    { title: 'Free to use', body: 'Every tool works without an account. Premium adds faster updates and more alerts.' },
    { title: 'Cards stay with Stripe', body: 'Payment details go to Stripe and never touch our servers. Cancel any time from your account.' },
    { title: 'Tested on every change', body: 'Thousands of automated tests cover prices, tax, alerts and payments, and run before any change goes live.' },
    { title: 'Run by the person who built it', body: 'Questions on Discord or by email go to the developer who wrote the code, not a support queue.' },
  ]}
  questions={[
    { q: 'Is OSRS Exchange free?', a: 'Yes. Every tool works without an account. Premium adds price updates every 6 seconds and more alerts, and one subscription covers both OSRS Exchange and RS3 Exchange.' },
    { q: 'Where do OSRS Exchange’s prices come from?', a: 'From the RuneScape Wiki’s real-time price data, the source the community already relies on. Prices come in as items trade, and every margin, profit and chart updates as they do.' },
    { q: 'Does OSRS Exchange include Grand Exchange tax?', a: 'Yes. Every profit is after the Grand Exchange’s 2% tax, with its 50 gp floor, 5M cap and exempt items.' },
    { q: 'How do OSRS Exchange’s price alerts work?', a: 'Choose an item and a price, and OSRS Exchange sends you a Discord message or an email the moment the item gets there.' },
    { q: 'Is it safe to pay for OSRS Exchange Premium?', a: 'Yes. Premium is billed through Stripe, so your card details go to Stripe and never reach our servers. Sales tax is worked out at checkout, and you can cancel any time from your account.' },
    { q: 'Who makes OSRS Exchange?', a: 'Leeman Software, a one-developer studio, designs, builds and runs it, from the price feed to the servers. OSRS Exchange is independent and not affiliated with Jagex Ltd, the makers of Old School RuneScape.' },
  ]}
/>
