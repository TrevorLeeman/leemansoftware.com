---
import Exchange from '../../layouts/Exchange.astro';
import { product } from '../../site';

// Facts checked against www.rs3.exchange on 2026-10-04. When the site changes, change them here.
---

<Exchange
  product={product('rs3-exchange')}
  title="Live Grand Exchange prices for RuneScape 3"
  description="RS3 Exchange is a free website with live Grand Exchange prices for RuneScape 3: margins after tax, years of price history, recipe profit and price alerts for every tradeable item. Built by Leeman Software."
  lede="RS3 Exchange is a free website with live Grand Exchange prices for RuneScape 3, and years of price history behind every item. Players use it to find items worth flipping, see what recipes make, and check how prices have moved."
  features={[
    { title: 'Live margins', body: 'Every tradeable item in one table: buy and sell price, profit after tax, volume and buy limit.' },
    { title: 'Years of history', body: 'A page and chart for every item, from the last few minutes back through years of trading.' },
    { title: 'Recipe profit', body: 'What every recipe makes at today’s prices, from skilling to set making.' },
    { title: 'Price alerts', body: 'A Discord message or email the moment an item hits your price.' },
  ]}
  stats={[
    { value: '7,000+', label: 'item pages' },
    { value: '6 s', label: 'between price updates on Premium' },
    { value: 'No ads', label: 'on any plan' },
  ]}
  built={[
    { title: 'Prices as they trade', body: 'Live prices come in from the RuneScape Wiki as items trade, and every margin, profit and chart updates as they do.' },
    { title: 'One app, two games', body: 'RS3 Exchange and OSRS Exchange run on one codebase, each with its own game’s rules.' },
    { title: 'Accounts and payments', body: 'Google sign-in, synced lists, alerts and a Premium subscription that covers both sites.' },
  ]}
  trust={[
    { title: 'Public data', body: 'Prices come from the RuneScape Wiki’s real-time data, the source the community already relies on.' },
    { title: 'Tax included', body: 'Every profit is after the Grand Exchange’s 2% tax, with its 50 gp floor and exempt items.' },
    { title: 'Free, without ads', body: 'Every tool works without an account. Premium adds faster updates and more alerts.' },
  ]}
/>
