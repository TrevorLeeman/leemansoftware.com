---
import { url } from '../../url';
import Doc from '../../layouts/Doc.astro';
import { company, email, product } from '../../site';

const faqs = [
  {
    q: 'I didn’t get my sign-in code.',
    a: 'Codes usually arrive within a minute. Check your spam or junk folder, and make sure the email address is spelled correctly. Each code works for 10 minutes, so if yours has expired, ask for a new one.',
  },
  {
    q: 'How do I join a group?',
    a: 'Open the invite link someone sent you. You’ll see the group’s name and who’s in it, then tap Join group. If they added you by name before you joined, choose which person is you, and the expenses already recorded for you become yours.',
  },
  {
    q: 'Someone left or was removed. What happens to their expenses?',
    a: 'They stay in the group under that person’s name, so everyone else’s balances stay correct. Removed someone by mistake? Add them back from the group’s settings: History, then Removed people.',
  },
  {
    q: 'Someone is in the group twice.',
    a: 'The group’s owner or an admin can merge the two in the group’s settings, with Merge people. Their expenses come together under one person.',
  },
  {
    q: 'Someone joined as the wrong person.',
    a: 'The group’s owner or an admin can take away their access from Remove. The person they picked stays in the group with all their expenses, ready for the right person to join as.',
  },
  {
    q: 'Can I use different currencies in one group?',
    a: 'Yes. Wallyt has 161 currencies, and each expense can be in its own. Paid on a card, it counts in the group’s currency at that day’s exchange rate. Paid in cash, it stays in the currency it was paid in, to be paid back the same way. The owner or an admin can convert what’s left into the group’s currency in one step.',
  },
  {
    q: 'I changed my name, but a group still shows the old one.',
    a: 'Each group keeps its own name for you. Change it from the pencil on your own row in that group’s settings.',
  },
  {
    q: 'How do I stop a repeating expense?',
    a: 'Edit the newest copy and set it to Doesn’t repeat, or delete it.',
  },
  {
    q: 'Can I leave a group I owe money in?',
    a: 'Yes. What you owe stays until it’s settled, and the group’s invite link brings you back as you were. If you own the group, make someone else the owner first.',
  },
  {
    q: 'Can I bring my history over from Splitwise or a spreadsheet?',
    a: 'Yes. Export your group from Splitwise as a CSV file, or use any spreadsheet saved as CSV, then import it into Wallyt from Import and export. You match each person in the file to someone in your Wallyt group.',
  },
  {
    q: 'Can I get my expenses out of Wallyt?',
    a: 'Yes. In Import and export, choose Export to download or share the group’s expenses as a CSV file for any spreadsheet.',
  },
  {
    q: 'I deleted an expense by mistake.',
    a: 'Tap Undo right after deleting it, or restore it later from Deleted expenses in the group’s settings.',
  },
  {
    q: 'Who can delete a group?',
    a: 'Only its owner. The owner or an admin can also clear all of a group’s expenses. Both are permanent, so Wallyt asks first.',
  },
  {
    q: 'How do I delete my account?',
    a: 'In Wallyt, open Account and tap Delete account. See Delete your Wallyt account for exactly what is deleted, and for asking us by email instead.',
    link: { href: '/wallyt/delete-account', label: 'Delete your Wallyt account' },
  },
];

// The same questions for search engines and AI answers, with the deletion answer's link spelled out.
const faqSchema = {
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.link ? `${f.a.replace(f.link.label, `${f.link.label} (${company.url}${f.link.href}/)`)}` : f.a,
    },
  })),
};
---

<Doc
  title="Wallyt support"
  pageType="FAQPage"
  schema={faqSchema}
  eyebrow="Wallyt"
  eyebrowHref="/wallyt"
  product={product('wallyt')}
  description="Get help with Wallyt: sign-in codes, joining groups, currencies, imports, and how to reach us."
>
  <div class="contact-card">
    <p class="contact-label">email us</p>
    <p class="contact-line">
      <a class="contact-mail" href={`mailto:${email}`}>{email}</a>
      <button class="copy" type="button" data-copy={email} aria-label={`Copy ${email}`}>Copy</button>
    </p>
    <p>
      Tell us what you were doing and what happened, and include a screenshot if you can. We read
      every message and usually reply within two business days.
    </p>
  </div>

  <h2>Common questions</h2>
  <dl class="faq">
    {
      faqs.map((f) => (
        <div>
          <dt>{f.q}</dt>
          <dd>
            {f.link ? (
              <>
                {f.a.split(f.link.label)[0]}
                <a href={url(f.link.href)}>{f.link.label}</a>
                {f.a.split(f.link.label)[1]}
              </>
            ) : (
              f.a
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  <p>
    Questions about your data? Read the <a href={url('/wallyt/privacy')}>privacy policy</a> or email <a href={`mailto:${email}`}>{email}</a>.
  </p>
</Doc>

<style>
  .contact-card {
    margin-top: 2em;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule);
  }

  .contact-label {
    margin: 0 0 6px !important;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted) !important;
  }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 0 !important;
  }

  .contact-mail {
    font-family: var(--mono);
    font-size: clamp(18px, 2.6vw, 24px);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .contact-card p:last-child {
    margin: 14px 0 0;
  }

  .faq {
    margin: 0 0 2em;
  }

  .faq > div {
    padding-block: 18px;
    border-bottom: 1px solid var(--rule);
  }

  .faq dt {
    font-weight: 600;
    color: var(--ink);
  }

  .faq dd {
    margin: 6px 0 0;
    color: var(--ink-soft);
  }
</style>
