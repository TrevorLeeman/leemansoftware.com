---
import { url } from '../../url';
import Base from '../../layouts/Base.astro';
import ProductHero from '../../components/ProductHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Steps from '../../components/Steps.astro';
import Questions from '../../components/Questions.astro';
import { comingSoon, company, email, organizationRef, playerCount, product, wallytPlayUrl, type QA } from '../../site';

// Written for the person who has just been sent a Wallyt invite, or is looking for a way off
// Splitwise, and wants to know what the app does with their money before they put a trip in it.

const wallyt = product('wallyt');
const live = wallyt.status === 'live';
// Until it's out, nothing here says you can get it.
const what = live ? 'a free Android app for splitting shared costs' : 'a free app for splitting shared costs, coming soon to Android';
const description = live
  ? 'Wallyt is a free Android app for splitting shared costs: split any way, use any of 161 currencies, and settle up in fewer payments.'
  : 'Wallyt is a free app for splitting shared costs, coming soon to Android: split any way, use 161 currencies, and settle up in fewer payments.';

// Everything below is checked against the Wallyt app (docs/product.md, docs/decisions.md) on 2026-10-04.
const steps = [
  {
    title: 'Make a group and share one link',
    body: 'Name it, pick a currency and send the invite. Add people by name before they’ve joined: when they open the link they pick which one they are and take over that spot, with everything already split with them.',
  },
  {
    title: 'Add what you paid',
    body: 'Split it equally, by exact amounts, by percentage or by shares, with one person paying or several. Everyone’s balance updates on their own screen as you save.',
  },
  {
    title: 'Settle up in fewer payments',
    body: 'Ana pays a $60 dinner and Ben a $30 taxi, both split three ways. Wallyt has Cara pay Ana $30, and Ben pays nobody. What each person owes overall stays exactly the same.',
  },
];

const flat = [
  { title: 'Rent adds itself', body: 'Set rent, a subscription or the weekly shop to repeat every week, month or year, or any number of days you choose, and Wallyt adds it on the day.' },
  { title: 'Every change is kept', body: 'Each expense keeps a history of who changed what and when. Nobody can edit that history, so “I already paid that” is settled by looking, not arguing.' },
  { title: 'Deletes can be undone', body: 'A deleted expense goes to Deleted expenses, where anyone in the group can bring it back. Removing a person can be undone too.' },
];

const trip = [
  { title: '161 currencies', body: 'Add each expense in the currency you paid in. One group can hold as many currencies as the trip needs.' },
  { title: 'The rate of the day, kept', body: 'An expense in another currency counts at the exchange rate of its own day, and that rate is saved with the expense, so a debt doesn’t drift with the market after you’re home.' },
  { title: 'Paid in cash?', body: 'Mark an expense to stay in the currency it was paid in, and it’s paid back the same way.' },
];

const exact = [
  { title: 'Whole cents', body: 'Amounts are stored as whole cents, never fractions, so nothing is lost to rounding.' },
  { title: 'Totals that must agree', body: 'Wallyt’s server refuses any expense where what was paid, what is owed and the total don’t match.' },
  { title: 'The odd cent, shared fairly', body: 'When a split doesn’t divide evenly, the leftover cents go to people picked at random, so the same person doesn’t always pay the extra one.' },
  { title: 'Tested throughout', body: 'More than 900 automated tests cover the app, from the splitting, currency and settling-up maths to whole journeys on a phone.' },
];

const questions: QA[] = [
  { q: 'Is Wallyt free?', a: 'Yes. Wallyt is free, with no ads.' },
  {
    q: 'When does Wallyt come out?',
    a: live
      ? 'Wallyt is out now on Google Play for Android.'
      : `Wallyt is in testing and is coming to Google Play first. Email ${email} and you’ll get one message when it’s out.`,
  },
  { q: 'Is there an iPhone version?', a: 'Not yet. Wallyt is launching on Android first.' },
  {
    q: 'Do my friends need Wallyt before I can add them?',
    a: 'No. Add them by name and start splitting. When they open your invite link they pick which person they are and take over that spot, with everything already split with them.',
  },
  { q: 'Do I need a password?', a: 'No. You sign in with a code sent to your email, or with Google.' },
  {
    q: 'Does Wallyt move money or connect to my bank?',
    a: 'No. Wallyt keeps the record of who owes whom. You pay each other however you like, then record the payment in Wallyt.',
  },
  {
    q: 'Can one group use more than one currency?',
    a: 'Yes. Wallyt has 161 currencies, and each expense can be in its own. Paid on a card, it counts in the group’s currency at that day’s exchange rate. Paid in cash, it can stay in the currency it was paid in.',
  },
  { q: 'Does Wallyt work offline?', a: 'Not yet. Adding or changing an expense needs a connection.' },
  {
    q: 'Can I move my groups from Splitwise?',
    a: 'Yes. Export a group from Splitwise as a CSV file and import it into Wallyt, which matches the people in the file to the people in your group, adds anyone new, and shows you every row before any expense is saved.',
  },
  {
    q: 'Can I get my expenses out again?',
    a: 'Yes. Any group exports as a CSV file that opens in Excel, Numbers or Google Sheets, and Wallyt can import it again.',
  },
  {
    q: 'Who makes Wallyt?',
    a: `${company.brand}, the independent studio that also makes OSRS Exchange and RS3 Exchange.`,
  },
];

const policies = [
  { href: '/wallyt/privacy', label: 'Privacy policy' },
  { href: '/wallyt/terms', label: 'Terms of use' },
  { href: '/wallyt/delete-account', label: 'Delete your account' },
  { href: '/wallyt/support', label: 'Support' },
];
---

<Base
  product={wallyt}
  title="Split bills, rent and trip costs with friends"
  description={description}
  questions={questions}
  schema={{
    '@type': 'MobileApplication',
    name: 'Wallyt',
    description: wallyt.definition,
    url: `${company.url}/wallyt/`,
    operatingSystem: 'Android',
    applicationCategory: 'FinanceApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: organizationRef,
    creator: organizationRef,
    ...(live ? { installUrl: wallytPlayUrl } : {}),
  }}
>
  <ProductHero product={wallyt} status={live ? undefined : comingSoon}>
    <Fragment slot="lede">
      Wallyt is {what}. Add what you paid for the flat, the trip or the dinner, and everyone in the
      group sees the same balances. When it’s time to settle, Wallyt works out who pays whom, in as
      few payments as it can.
    </Fragment>
    <Fragment slot="actions">
      {
        live ? (
          <a class="button primary" href={wallytPlayUrl} rel="noopener">Get it on Google Play</a>
        ) : (
          <a class="button primary" href={`mailto:${email}?subject=Tell%20me%20when%20Wallyt%20launches`}>
            Tell me when it launches
          </a>
        )
      }
      <a class="button" href="#how">How it works</a>
    </Fragment>
  </ProductHero>

  <section class="wrap section" id="how" aria-labelledby="how-title">
    <SectionHead title="How it works" id="how-title">
      Three steps, and nobody needs the app before you add them.
    </SectionHead>
    <Steps steps={steps} />
  </section>

  <section class="wrap section" id="flat" aria-labelledby="flat-title">
    <SectionHead title="For the flat" id="flat-title">
      The bills that come round every month, and the housemate who swears they already paid.
    </SectionHead>
    <FeatureGrid features={flat} />
  </section>

  <section class="wrap section" id="trip" aria-labelledby="trip-title">
    <SectionHead title="For the trip" id="trip-title">
      Three countries, two cards and a pile of cash, settled properly when you’re home.
    </SectionHead>
    <FeatureGrid features={trip} />
  </section>

  <section class="wrap section" id="exact" aria-labelledby="exact-title">
    <SectionHead title="Exact with money" id="exact-title">
      People stop trusting a shared tab the first time a balance moves by itself. This is what Wallyt
      does so that never happens.
    </SectionHead>
    <FeatureGrid features={exact} />
  </section>

  <section class="wrap section" id="splitwise" aria-labelledby="splitwise-title">
    <SectionHead title="Coming from Splitwise" id="splitwise-title">
      Export a group from Splitwise as a CSV file and import it into Wallyt. Wallyt works out who each
      person in the file is, shows you every row before any expense is saved, and marks the ones that
      look like duplicates.
    </SectionHead>
    <p class="policies">
      <a href={url('/wallyt/splitwise-alternative')}>How to move a group from Splitwise to Wallyt</a>
    </p>
  </section>

  <section class="wrap section" id="data" aria-labelledby="data-title">
    <SectionHead title="Your data stays yours" id="data-title">
      Wallyt stores what it needs to work: your name, your email, a photo if you add one, the groups
      you’re in, and the expenses and people you add. The people in your groups see them, and anyone
      you send a group’s invite link to sees its name and who’s in it. No ads, no tracking, and your
      data is never sold. You can export a group at any time, and ask for your account to be deleted
      whenever you like. The privacy policy has the full list.
    </SectionHead>
    <p class="policies">
      {policies.map((l) => <a href={url(l.href)}>{l.label}</a>)}
    </p>
  </section>

  <section class="wrap section" id="questions" aria-labelledby="questions-title">
    <SectionHead title="Questions people ask" id="questions-title" />
    <Questions questions={questions} />
  </section>

  <section class="wrap section" id="maker" aria-labelledby="maker-title">
    <SectionHead title="Who makes it" id="maker-title">
      Wallyt is designed, built and run by <a href={url('/about')}>{company.brand}</a>, the independent
      studio behind OSRS Exchange, which more than {playerCount} players have used. Questions come straight
      to us, the studio that wrote the app.
    </SectionHead>
    <p class="policies">
      <a href={`mailto:${email}`}>{email}</a>
    </p>
  </section>
</Base>

<style>
  .section {
    padding-top: clamp(96px, 12vw, 160px);
  }

  .policies {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: -12px 0 0;
  }

  .policies a {
    font-weight: 500;
    text-decoration-color: var(--rule-strong);
  }

  .policies a:hover {
    text-decoration-color: var(--accent);
  }
</style>
