---
import Base from '../../layouts/Base.astro';
import { email } from '../../site';

const features = [
  {
    title: 'Groups for anything shared',
    body: 'Make a group for the apartment, a trip or a standing dinner, and share one link to bring everyone in.',
  },
  {
    title: 'Add people before they join',
    body: 'Add someone by name or from your contacts and start splitting right away. Their share is waiting when they join.',
  },
  {
    title: 'Every way to split',
    body: 'Split equally, by exact amounts, by percentage or by shares, with one person paying or several.',
  },
  {
    title: 'Any currency',
    body: 'Each expense can be in its own currency, converted at that day’s exchange rate so balances add up.',
  },
  {
    title: 'Fewer payments',
    body: 'Simplify debts works out the smallest set of payments that settles the whole group.',
  },
  {
    title: 'Repeating costs',
    body: 'Rent and subscriptions can repeat every week, month or year, and Wallyt adds each one on its day.',
  },
  {
    title: 'A full history',
    body: 'Every change to an expense is recorded, and deleting one can be undone.',
  },
  {
    title: 'Bring your Splitwise history',
    body: 'Import a Splitwise export and keep every past expense, matched to the right people.',
  },
  {
    title: 'No passwords',
    body: 'Sign in with a code sent to your email, or with Google.',
  },
];
---

<Base
  title="Wallyt"
  section="wallyt"
  description="Wallyt splits shared costs with roommates, trips and friends. Coming soon to Google Play."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="badge soon">coming soon to Google Play</p>
        <h1 class="title">Wallyt</h1>
        <p class="lede">
          Split rent, trips and dinners with the people you share them with. Everyone sees the same
          balances, and settling up takes as few payments as possible.
        </p>
        <div class="actions">
          <a class="button primary" href={`mailto:${email.hello}?subject=Tell%20me%20when%20Wallyt%20launches`}>
            Tell me when it launches
          </a>
          <a class="button" href="/wallyt/support">Get help</a>
        </div>
      </div>
      <img class="app-icon" src="/products/wallyt.webp" alt="" width="160" height="160" />
    </div>
  </section>

  <section class="wrap section" aria-labelledby="features-title">
    <p class="label" id="features-title">features</p>
    <ul class="grid">
      {
        features.map((f) => (
          <li>
            <h2>{f.title}</h2>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="links-title">
    <p class="label" id="links-title">help and policies</p>
    <ul class="link-list">
      <li>
        <a href="/wallyt/support">
          <span class="link-title">Support</span>
          <span class="link-body">Answers to common questions, and how to reach us.</span>
          <span class="path">/wallyt/support</span>
        </a>
      </li>
      <li>
        <a href="/wallyt/privacy">
          <span class="link-title">Privacy policy</span>
          <span class="link-body">What Wallyt stores, who can see it, and what we never do with it.</span>
          <span class="path">/wallyt/privacy</span>
        </a>
      </li>
      <li>
        <a href="/wallyt/delete-account">
          <span class="link-title">Delete your account</span>
          <span class="link-body">How to delete your Wallyt account and what happens to your data.</span>
          <span class="path">/wallyt/delete-account</span>
        </a>
      </li>
    </ul>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-block: clamp(56px, 9vw, 112px) clamp(48px, 7vw, 88px);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 70% 80% at 80% 40%, #000 25%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 80% 40%, #000 25%, transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 48px;
  }

  .hero h1 {
    margin-top: 22px;
    font-size: clamp(52px, 9vw, 96px);
  }

  .hero .lede {
    margin-top: 18px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .app-icon {
    width: clamp(120px, 16vw, 168px);
    height: auto;
    aspect-ratio: 1;
    border-radius: 22%;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent), 0 24px 48px -28px rgb(15 118 110 / 0.6);
  }

  @media (max-width: 700px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .app-icon {
      order: -1;
      width: 88px;
    }
  }

  .section {
    padding-top: clamp(56px, 8vw, 96px);
  }

  /* Hairlines between cells come from the grid's background showing through 1px gaps. */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--rule);
    overflow: hidden;
  }

  .grid li {
    padding: 22px 22px 24px;
    background: var(--surface);
  }

  .grid h2 {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .grid p {
    margin: 0;
    font-size: 15px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .grid li {
      padding: 18px 16px 20px;
    }
  }

  .link-list {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .link-list li + li {
    border-top: 1px solid var(--rule);
  }

  .link-list a {
    display: grid;
    grid-template-columns: minmax(0, 13em) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 24px;
    padding: 18px 20px;
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .link-list a:hover {
    background: color-mix(in srgb, var(--ink) 2.5%, transparent);
  }

  .link-title {
    font-weight: 600;
  }

  .link-body {
    color: var(--ink-soft);
  }

  .path {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .link-list a {
      grid-template-columns: 1fr;
      padding: 16px;
    }
  }
</style>
