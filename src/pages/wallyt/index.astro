---
import { url } from '../../url';
import Base from '../../layouts/Base.astro';
import ProductHero from '../../components/ProductHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import { company, email, organizationRef, product, wallytPlayUrl } from '../../site';

const wallyt = product('wallyt');
const live = wallyt.status === 'live';
const description =
  'Wallyt is a free Android app for splitting costs with roommates, trips and friends: every way to split, 161 currencies, and the fewest payments to settle up.';

// Checked against the Wallyt app (docs/product.md) on 2026-10-04.
const features = [
  { title: 'Every way to split', body: 'Equally, by amounts, by percentage or by shares, with one payer or several.' },
  { title: '161 currencies', body: 'Each expense in its own currency, converted at that day’s rate or paid back as it was spent.' },
  { title: 'Fewer payments', body: 'Wallyt works out the fewest payments that square everyone up.' },
  { title: 'Repeating costs', body: 'Rent and subscriptions add themselves on schedule.' },
  { title: 'Bring your history', body: 'Import from Splitwise or any spreadsheet, and export to CSV any time.' },
  { title: 'No passwords', body: 'Sign in with a code sent to your email, or with Google.' },
];

const built = [
  { title: 'One codebase, Android and web', body: 'Built with React Native and Expo, so the app and its web version share every screen.' },
  { title: 'Live for everyone', body: 'A change one person makes shows up on everyone else’s screen as it happens.' },
  { title: 'Money maths that adds up', body: 'Exchange rates are saved with each expense, so every balance adds up to the cent.' },
];

const policies = [
  { href: '/wallyt/privacy', label: 'Privacy policy' },
  { href: '/wallyt/terms', label: 'Terms of use' },
  { href: '/wallyt/delete-account', label: 'Delete your account' },
  { href: '/wallyt/support', label: 'Support' },
];
---

<Base
  product={wallyt}
  title="Split expenses with roommates, trips and friends"
  description={description}
  schema={{
    '@type': 'MobileApplication',
    name: 'Wallyt',
    description,
    url: `${company.url}/wallyt/`,
    operatingSystem: 'Android',
    applicationCategory: 'FinanceApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: organizationRef,
    creator: organizationRef,
    ...(live ? { installUrl: wallytPlayUrl } : {}),
  }}
>
  <ProductHero product={wallyt} status={live ? undefined : 'Coming soon to Google Play'}>
    <Fragment slot="lede">
      Wallyt is a free Android app for splitting shared costs. Add what you spend with roommates, on
      trips or at dinner, and everyone sees the same balances until you settle up.
    </Fragment>
    <Fragment slot="actions">
      {
        live ? (
          <a class="button primary" href={wallytPlayUrl} rel="noopener">Get it on Google Play</a>
        ) : (
          <a class="button primary" href={`mailto:${email}?subject=Tell%20me%20when%20Wallyt%20launches`}>
            Tell me when it launches
          </a>
        )
      }
    </Fragment>
  </ProductHero>

  <section class="wrap section" id="features" aria-labelledby="features-title">
    <SectionHead title="Everything a shared cost needs" id="features-title" />
    <FeatureGrid features={features} />
  </section>

  <section class="wrap section" id="built" aria-labelledby="built-title">
    <SectionHead title="Built to be trusted with money" id="built-title">
      {company.brand} designs, builds and runs Wallyt, from the app to the servers behind it.
    </SectionHead>
    <FeatureGrid features={built} />
  </section>

  <section class="wrap section" id="data" aria-labelledby="data-title">
    <SectionHead title="Your data stays yours" id="data-title">
      Wallyt stores your name, email, the groups you’re in and the expenses you add, and shows them
      only to the people in your groups. No ads, no tracking, and your data is never sold. You can
      delete your account at any time.
    </SectionHead>
    <p class="policies">
      {policies.map((l) => <a href={url(l.href)}>{l.label}</a>)}
      <a href={`mailto:${email}`}>{email}</a>
    </p>
  </section>
</Base>

<style>
  .section {
    padding-top: clamp(96px, 12vw, 160px);
  }

  .policies {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: -12px 0 0;
  }

  .policies a {
    font-weight: 500;
    text-decoration-color: var(--rule-strong);
  }

  .policies a:hover {
    text-decoration-color: var(--accent);
  }
</style>
