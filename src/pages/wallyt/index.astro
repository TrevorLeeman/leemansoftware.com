---
import Base from '../../layouts/Base.astro';
import { email } from '../../site';

const features = [
  {
    title: 'Groups for anything shared',
    body: 'Make a group for the apartment, a trip or a standing dinner, and share one link to bring everyone in.',
  },
  {
    title: 'Add people before they join',
    body: 'Add someone by name or from your contacts and start splitting right away. Their share is waiting when they join.',
  },
  {
    title: 'Every way to split',
    body: 'Split equally, by exact amounts, by percentage or by shares, with one person paying or several.',
  },
  {
    title: 'Any currency',
    body: 'Each expense can be in its own currency, converted at that day’s exchange rate so balances add up.',
  },
  {
    title: 'Fewer payments',
    body: 'Simplify debts works out the smallest set of payments that settles the whole group.',
  },
  {
    title: 'Repeating costs',
    body: 'Rent and subscriptions can repeat every week, month or year, and Wallyt adds each one on its day.',
  },
  {
    title: 'A full history',
    body: 'Every change to an expense is recorded, and deleting one can be undone.',
  },
  {
    title: 'Bring your Splitwise history',
    body: 'Import a Splitwise export and keep every past expense, matched to the right people.',
  },
  {
    title: 'No passwords',
    body: 'Sign in with a code sent to your email, or with Google.',
  },
];
---

<Base
  title="Wallyt"
  section="wallyt"
  description="Wallyt splits shared costs with roommates, trips and friends. Coming soon to Google Play."
>
  <section class="hero wrap">
    <img class="app-icon" src="/products/wallyt.webp" alt="" width="104" height="104" />
    <p class="eyebrow">Coming soon to Google Play</p>
    <h1 class="display">Wallyt</h1>
    <p class="lede">
      Split rent, trips and dinners with the people you share them with. Everyone sees the same
      balances, and settling up takes as few payments as possible.
    </p>
    <div class="actions">
      <a class="button primary" href={`mailto:${email.hello}?subject=Tell%20me%20when%20Wallyt%20launches`}>
        Tell me when it launches
      </a>
      <a class="button" href="/wallyt/support">Get help</a>
    </div>
  </section>

  <section class="wrap features" aria-labelledby="features-title">
    <div class="section-head">
      <p class="eyebrow" id="features-title">What it does</p>
    </div>
    <ul class="grid">
      {
        features.map((f) => (
          <li>
            <h2>{f.title}</h2>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap links" aria-labelledby="links-title">
    <div class="section-head">
      <p class="eyebrow" id="links-title">Help and policies</p>
    </div>
    <ul class="link-list">
      <li>
        <a href="/wallyt/support">
          <span class="link-title">Support</span>
          <span class="link-body">Answers to common questions, and how to reach us.</span>
        </a>
      </li>
      <li>
        <a href="/wallyt/privacy">
          <span class="link-title">Privacy policy</span>
          <span class="link-body">What Wallyt stores, who can see it, and what we never do with it.</span>
        </a>
      </li>
      <li>
        <a href="/wallyt/delete-account">
          <span class="link-title">Delete your account</span>
          <span class="link-body">How to delete your Wallyt account and what happens to your data.</span>
        </a>
      </li>
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(56px, 10vw, 128px) clamp(64px, 9vw, 112px);
  }

  .app-icon {
    width: 104px;
    height: 104px;
    margin-bottom: 32px;
    border-radius: 24px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent), 0 24px 48px -24px rgb(15 118 110 / 0.55);
  }

  .hero h1 {
    margin-top: 16px;
    font-size: clamp(72px, 13vw, 156px);
  }

  .hero .lede {
    margin-top: 24px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    transition: background-color 180ms ease, box-shadow 180ms ease;
  }

  .button:hover {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .button.primary {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .button.primary:hover {
    background: var(--ink-soft);
  }

  .section-head {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    padding: 32px 32px 36px 0;
    border-bottom: 1px solid var(--rule);
  }

  .grid li:not(:nth-child(3n + 1)) {
    padding-left: 32px;
    border-left: 1px solid var(--rule);
  }

  .grid h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 27px;
    line-height: 1.12;
  }

  .grid p {
    margin: 0;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .grid li,
    .grid li:not(:nth-child(3n + 1)) {
      padding: 28px 24px 30px 0;
      border-left: none;
    }

    .grid li:nth-child(2n) {
      padding-left: 24px;
      border-left: 1px solid var(--rule);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .grid li,
    .grid li:nth-child(2n) {
      padding: 24px 0;
      border-left: none;
    }
  }

  .links {
    padding-top: clamp(80px, 11vw, 136px);
  }

  .link-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-list li {
    border-bottom: 1px solid var(--rule);
  }

  .link-list a {
    display: grid;
    grid-template-columns: minmax(0, 15em) minmax(0, 1fr);
    gap: 4px 32px;
    padding-block: 22px;
    text-decoration: none;
  }

  .link-title {
    font-family: var(--serif);
    font-size: 27px;
    line-height: 1.15;
  }

  .link-list a:hover .link-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .link-body {
    align-self: center;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .link-list a {
      grid-template-columns: 1fr;
    }
  }
</style>
