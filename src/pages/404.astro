---
import { url } from '../url';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="wrap missing">
    <p class="label">404</p>
    <h1 class="title">This page isn’t here.</h1>
    <p class="lede">It may have moved, or the link may be mistyped.</p>
    <p class="back"><a class="button" href={url('/')}>Go to the home page</a></p>
  </section>
</Base>

<style>
  .missing {
    padding-block: clamp(72px, 12vw, 160px) 0;
  }

  .missing h1 {
    margin: 14px 0 18px;
    font-size: clamp(36px, 6vw, 64px);
  }

  .back {
    margin-top: 28px;
  }
</style>
