---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** Short lowercase label above the title, e.g. "wallyt". */
  eyebrow: string;
  /** Shown under the title, e.g. "Last updated October 2, 2026". */
  meta?: string;
  section?: 'wallyt';
}

const { title, description, eyebrow, meta, section } = Astro.props;
---

<Base title={title} description={description} section={section}>
  <article class="wrap doc">
    <header class="doc-head">
      <p class="label">{eyebrow.toLowerCase()}</p>
      <h1 class="title">{title}</h1>
      {meta && <p class="meta">{meta}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .doc-head {
    padding-block: clamp(48px, 8vw, 96px) clamp(28px, 4vw, 40px);
    margin-bottom: 8px;
    border-bottom: 1px solid var(--rule);
  }

  .doc-head h1 {
    margin-top: 14px;
    font-size: clamp(34px, 5.4vw, 56px);
  }

  .meta {
    margin: 16px 0 0;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .prose > :global(:first-child) {
    margin-top: 2em;
  }
</style>
