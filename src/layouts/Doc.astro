---
import Base from './Base.astro';
import { url } from '../url';
import type { Product } from '../site';

interface Props {
  title: string;
  description: string;
  /** Short label above the title, e.g. "wallyt". */
  eyebrow: string;
  /** Where the label links back to, e.g. "/wallyt". */
  eyebrowHref?: string;
  /** Shown under the title, e.g. "Wallyt, by Leeman Software". */
  meta?: string;
  /** When a policy last changed, as YYYY-MM-DD. Shown as "Last updated October 2, 2026" in place of `meta`. */
  updated?: string;
  /** The product subsite this page belongs to. */
  product?: Product;
  /** Passed through to Base: the page's schema.org type and its own fields, and the questions it answers. */
  pageType?: string;
  schema?: Record<string, unknown>;
  questions?: { q: string; a: string }[];
}

const { title, description, eyebrow, eyebrowHref, meta, updated, product, pageType, schema, questions } = Astro.props;
const updatedText = updated
  ? new Date(`${updated}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : undefined;

// Give every h2 an id and list them as the page's contents.
const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/&[a-z]+;|<[^>]+>/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const headings: { id: string; text: string }[] = [];
const html = (await Astro.slots.render('default')).replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_, attrs, inner) => {
  const text = inner.replace(/<[^>]+>/g, '').trim();
  const id = slugify(text);
  headings.push({ id, text });
  return `<h2${attrs} id="${id}">${inner}<a class="anchor" href="#${id}" aria-label="Link to this section">#</a></h2>`;
});
const hasToc = headings.length >= 4;
---

<Base title={title} description={description} product={product} pageType={pageType} schema={schema} questions={questions} updated={updated}>
  <article class="wrap doc">
    <header class="doc-head">
      {
        eyebrowHref ? (
          <a class="label crumb" href={url(eyebrowHref)}>{eyebrow.toLowerCase()}</a>
        ) : (
          <p class="label">{eyebrow.toLowerCase()}</p>
        )
      }
      <h1 class="title">{title}</h1>
      {
        updated ? (
          <p class="meta">
            Last updated <time datetime={updated}>{updatedText}</time>
          </p>
        ) : (
          meta && <p class="meta">{meta}</p>
        )
      }
    </header>

    <div class:list={['doc-body', { 'has-toc': hasToc }]}>
      {
        hasToc && (
          <nav class="toc" aria-label="On this page">
            <p class="toc-title">On this page</p>
            <ol>
              {headings.map((h) => (
                <li>
                  <a href={`#${h.id}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      {
        hasToc && (
          <details class="toc-fold">
            <summary>On this page</summary>
            <ol>
              {headings.map((h) => (
                <li>
                  <a href={`#${h.id}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
      <div class="prose" set:html={html} />
    </div>
  </article>
</Base>

<style>
  .doc-head {
    padding-block: clamp(48px, 8vw, 96px) clamp(28px, 4vw, 40px);
    border-bottom: 1px solid var(--rule);
  }

  .crumb {
    display: inline-block;
    text-decoration: none;
  }

  .crumb:hover {
    color: var(--ink);
  }

  .doc-head h1 {
    margin-top: 14px;
    font-size: clamp(34px, 5.4vw, 56px);
  }

  .meta {
    margin: 16px 0 0;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .doc-body.has-toc {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) 220px;
    justify-content: space-between;
    gap: 64px;
  }

  .prose > :global(:first-child) {
    margin-top: 2em;
  }

  .toc {
    order: 2;
    position: sticky;
    top: 92px;
    align-self: start;
    margin-top: 2.4em;
    padding-left: 16px;
    border-left: 1px solid var(--rule);
  }

  .toc-title,
  .toc-fold summary {
    margin: 0 0 10px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .toc ol,
  .toc-fold ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc li,
  .toc-fold li {
    margin-bottom: 8px;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .toc a,
  .toc-fold a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .toc a:hover,
  .toc-fold a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .toc-fold {
    display: none;
  }

  /* The section being read is marked with the logo's cursor, set on the contents' rule. */
  .toc li {
    position: relative;
  }

  .toc a[aria-current='true'] {
    color: var(--ink);
  }

  .toc a[aria-current='true']::before {
    content: '';
    position: absolute;
    top: 0.25em;
    left: -17px;
    width: 3px;
    height: 1em;
    border-radius: 1px;
    background: var(--cursor);
  }

  .prose :global(h2) {
    position: relative;
  }

  .prose :global(.anchor) {
    margin-left: 0.35em;
    font-family: var(--mono);
    font-weight: 400;
    color: var(--rule-strong);
    text-decoration: none;
    opacity: 0;
    transition: opacity 140ms ease, color 140ms ease;
  }

  .prose :global(h2:hover .anchor),
  .prose :global(.anchor:focus-visible) {
    opacity: 1;
  }

  .prose :global(.anchor:hover) {
    color: var(--accent);
  }

  /* On narrower screens the contents fold into one line above the text. */
  @media (max-width: 960px) {
    .doc-body.has-toc {
      display: block;
    }

    .toc {
      display: none;
    }

    .toc-fold {
      display: block;
      margin-top: 24px;
      border-bottom: 1px solid var(--rule);
    }

    .toc-fold summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 0;
      padding-block: 4px 14px;
      cursor: pointer;
      list-style: none;
    }

    .toc-fold summary::-webkit-details-marker {
      display: none;
    }

    .toc-fold summary::after {
      content: '+';
      font-size: 15px;
      color: var(--muted);
    }

    .toc-fold[open] summary::after {
      content: '\2212';
    }

    .toc-fold ol {
      padding-bottom: 12px;
    }

    .prose :global(.anchor) {
      opacity: 1;
    }
  }
</style>
