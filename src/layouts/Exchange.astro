---
// OSRS Exchange's and RS3 Exchange's subsites. They're one app run for two games, so they share one
// page and differ only in the facts each page passes in.
import Base from './Base.astro';
import ProductHero from '../components/ProductHero.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Stats from '../components/Stats.astro';
import Questions from '../components/Questions.astro';
import { company, organizationRef, type Product } from '../site';

type Point = { title: string; body: string };

interface Props {
  product: Product;
  /** The page's title in search results: what the product is, in a player's words. */
  title: string;
  description: string;
  lede: string;
  /** What players use it for. */
  features: Point[];
  /** Numbers that show the scale of what we built. */
  stats: { value: string; label: string }[];
  /** How it's built. */
  built: Point[];
  /** Why players can rely on it. */
  trust: Point[];
  /** What players ask before they use it, answered from the facts above. */
  questions: { q: string; a: string }[];
}

const { product: p, title, description, lede, features, stats, built, trust, questions } = Astro.props;
const site = p.site!;
const host = new URL(site).hostname.replace(/^www\./, '');
---

<Base
  product={p}
  title={title}
  description={description}
  questions={questions}
  schema={{
    '@type': 'WebApplication',
    name: p.name,
    description,
    url: site,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: organizationRef,
    creator: organizationRef,
  }}
>
  <ProductHero product={p}>
    <Fragment slot="lede">{lede}</Fragment>
    <Fragment slot="actions">
      <a class="button primary" href={site} rel="noopener">
        Open {host}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </a>
    </Fragment>
  </ProductHero>

  <section class="wrap section" id="features" aria-labelledby="features-title">
    <SectionHead title="Find the profit, then take it" id="features-title" />
    <FeatureGrid features={features} />
  </section>

  <section class="wrap section" id="built" aria-labelledby="built-title">
    <SectionHead title="Live data, at scale" id="built-title">
      {company.brand} designs, builds and runs {p.name}, from the price pipeline to the charts.
    </SectionHead>
    <Stats stats={stats} />
    <FeatureGrid features={built} />
  </section>

  <section class="wrap section" id="trust" aria-labelledby="trust-title">
    <SectionHead title="Prices you can rely on" id="trust-title" />
    <FeatureGrid features={trust} />
  </section>

  <section class="wrap section" id="questions" aria-labelledby="questions-title">
    <SectionHead title="Questions players ask" id="questions-title" />
    <Questions questions={questions} />
  </section>
</Base>

<style>
  .section {
    padding-top: clamp(96px, 12vw, 160px);
  }
</style>
