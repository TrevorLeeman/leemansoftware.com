---
// OSRS Exchange's and RS3 Exchange's subsites. They're one app run for two games, so they share one
// page, and src/exchange.ts fills in what each game's page says.
import Base from './Base.astro';
import ProductHero from '../components/ProductHero.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Plans from '../components/Plans.astro';
import Quotes from '../components/Quotes.astro';
import Questions from '../components/Questions.astro';
import { url } from '../url';
import { exchange } from '../exchange';
import { company, organizationRef, premium } from '../site';

interface Props {
  slug: 'osrs-exchange' | 'rs3-exchange';
}

const x = exchange(Astro.props.slug);
const p = x.product;
const checked = new Date(`${premium.checked}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const arrow = 'M7 17 17 7M8 7h9v9';
---

<Base
  product={p}
  title={x.title}
  description={x.description}
  questions={x.questions}
  updated={premium.checked}
  schema={{
    '@type': 'WebApplication',
    name: p.name,
    description: p.definition,
    url: x.site,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    featureList: x.features,
    offers: x.offers,
    ...(x.sameAs.length ? { sameAs: x.sameAs } : {}),
    publisher: organizationRef,
    creator: organizationRef,
  }}
>
  <ProductHero product={p}>
    <Fragment slot="lede">{x.lede}</Fragment>
    <Fragment slot="actions">
      <a class="button primary" href={x.site} rel="noopener">
        Open {x.host}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
      </a>
      <a class="button" href="#pricing">What Premium costs</a>
    </Fragment>
  </ProductHero>

  <section class="wrap section" id="uses" aria-labelledby="uses-title">
    <SectionHead title="What players use it for" id="uses-title">
      Most of it is free and needs no account. Each one links straight into the tool on {x.host}.
    </SectionHead>
    <FeatureGrid features={x.jobs} />
  </section>

  {
    x.quotes.length > 0 && (
      <section class="wrap section" id="players" aria-labelledby="players-title">
        <SectionHead title="In players’ words" id="players-title">
          Messages players have sent in the {p.name} Discord, as they were written.
        </SectionHead>
        <Quotes quotes={x.quotes} product={p} />
      </section>
    )
  }

  <section class="wrap section" id="pricing" aria-labelledby="pricing-title">
    <SectionHead title="Free, and what Premium adds" id="pricing-title" />
    <Plans plans={x.plans} />
    <p class="billing">{x.billing}</p>
    <p class="after">
      <a href={`${x.site}/premium`} rel="noopener">{p.name} Premium</a>
      <a href={`${x.site}/refund-policy`} rel="noopener">Refund policy</a>
      <span>Prices checked {checked}</span>
    </p>
  </section>

  <section class="wrap section" id="data" aria-labelledby="data-title">
    <SectionHead title="Where the numbers come from" id="data-title">
      Nothing on {p.name} is guessed. Here is where each number is read from, so you can check it yourself.
    </SectionHead>
    <FeatureGrid features={x.sources} />
  </section>

  <section class="wrap section" id="maker" aria-labelledby="maker-title">
    <SectionHead title="Who runs it" id="maker-title">
      {p.name} is made and run by <a href={url('/about')}>{company.brand}</a>, an independent studio founded by
      {company.founder}. You’re handing over a card, so here is how we run it.
    </SectionHead>
    <FeatureGrid features={x.runs} />
  </section>

  <section class="wrap section" id="questions" aria-labelledby="questions-title">
    <SectionHead title="Questions players ask" id="questions-title" />
    <Questions questions={x.questions} />
  </section>
</Base>

<style>
  .section {
    padding-top: clamp(96px, 12vw, 160px);
  }

  .billing {
    max-width: 44em;
    margin: clamp(24px, 3vw, 32px) 0 0;
    font-size: 15.5px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .after {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 28px;
    margin: 14px 0 0;
  }

  .after a {
    font-weight: 500;
    text-decoration-color: var(--rule-strong);
  }

  .after a:hover {
    text-decoration-color: var(--accent);
  }

  .after span {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }
</style>
