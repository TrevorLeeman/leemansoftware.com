---
import { url, withoutBase } from '../url';
import '../styles/global.css';
import Monogram from '../components/Monogram.astro';
import { execSync } from 'node:child_process';

import { company, email } from '../site';

interface Props {
  title?: string;
  description: string;
  /** Pages under /wallyt get the product's own links in the header. */
  section?: 'wallyt';
}

const { title, description, section } = Astro.props;
const fullTitle = title ? `${title} | ${company.brand}` : company.brand;
const canonical = new URL(withoutBase(Astro.url.pathname), company.url).href;
const year = new Date().getFullYear();
// The build stamp in the footer: when this copy of the site was built, and from which commit.
const built = new Date().toISOString().slice(0, 10);
let commit = '';
try {
  commit = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
} catch {
  // Not a git checkout; the stamp shows the date alone.
}
const path = withoutBase(Astro.url.pathname);
const current = (href: string) => (path === href ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.brand} />
    <meta property="og:title" content={title ?? company.brand} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${company.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script src={url('/site.js')} defer is:inline></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url('/')} aria-label={`${company.brand}, home`}>
          <Monogram size={28} />
          <span class="wordmark">Leeman <span>Software</span></span>
        </a>
        <nav aria-label="Main">
          {
            section === 'wallyt' ? (
              <>
                <a class="optional" href={url('/wallyt')} aria-current={current('/wallyt')}>Wallyt</a>
                <a href={url('/wallyt/support')} aria-current={current('/wallyt/support')}>Support</a>
                <a href={url('/wallyt/privacy')} aria-current={current('/wallyt/privacy')}>Privacy</a>
              </>
            ) : (
              <>
                <a href={url('/#rs3-exchange')}>Products</a>
                <a href={url('/#contact')}>Contact</a>
              </>
            )
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <a class="brand" href={url('/')} aria-label={`${company.brand}, home`}>
          <Monogram size={22} />
          <span class="wordmark">Leeman <span>Software</span></span>
        </a>
        <ul class="foot-links">
          <li><a href={url('/wallyt/support')}>Wallyt support</a></li>
          <li><a href={url('/wallyt/privacy')}>Wallyt privacy</a></li>
          <li><a href={url('/wallyt/delete-account')}>Delete a Wallyt account</a></li>
          <li><a href={url('/privacy')}>Website privacy</a></li>
        </ul>
      </div>

      <div class="wrap">
        <div class="fine">
          <p>
            &copy; {year} {company.legalName}. {company.brand} is its product studio.
            <span class="stamp">built {built}{commit && <> · <span title="Commit">{commit}</span></>}</span>
          </p>
          <p>
            OSRS Exchange and RS3 Exchange are independent and not affiliated with Jagex Ltd.
            RuneScape and Old School RuneScape are trademarks of Jagex Ltd.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 60px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .wordmark {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .wordmark span {
    font-weight: 400;
    color: var(--muted);
  }

  nav {
    display: flex;
    gap: 4px;
  }

  nav a {
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--ink-soft);
    text-decoration: none;
    transition: background-color 140ms ease, color 140ms ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  @media (max-width: 480px) {
    nav a.optional {
      display: none;
    }

    nav a {
      padding-inline: 8px;
    }
  }

  @media (max-width: 340px) {
    .wordmark span {
      display: none;
    }
  }

  .site-footer {
    margin-top: clamp(80px, 12vw, 136px);
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: 32px;
  }

  .foot .wordmark {
    font-size: 15px;
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot-links a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .foot-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 18px 36px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1.6;
  }

  .fine p {
    margin: 0;
    max-width: 60em;
  }

  .stamp {
    display: block;
    margin-top: 4px;
    color: color-mix(in srgb, var(--muted) 70%, transparent);
  }

</style>
