---
import { url, withoutBase } from '../url';
import '../styles/global.css';
import StudioHeader from '../components/StudioHeader.astro';
import StudioFooter from '../components/StudioFooter.astro';
import ProductHeader from '../components/ProductHeader.astro';
import ProductFooter from '../components/ProductFooter.astro';

import { company, type Product } from '../site';

interface Props {
  title?: string;
  description: string;
  /**
   * Pages of a product's subsite (Wallyt and its policies, the Exchange pages) get the product's
   * own header, footer and colors instead of the studio's.
   */
  product?: Product;
  /** An image for link previews, as a path on this site. Defaults to the product's or the studio's card. */
  image?: string;
  /** Structured data (schema.org) describing what the page is about, for search engines. */
  schema?: Record<string, unknown>;
}

const { title, description, product, schema } = Astro.props;
const image = Astro.props.image ?? (product ? `/og/${product.slug}.png` : '/og.png');
// A subsite's pages are titled for the product ("Terms of use | Wallyt"), or for the studio when
// the title already names the product ("Wallyt privacy policy | Leeman Software").
const owner = product ? product.name : company.brand;
const fullTitle = !title ? owner : `${title} | ${product && !title.includes(product.name) ? product.name : company.brand}`;
const canonical = new URL(withoutBase(Astro.url.pathname), company.url).href;
const theme = product ? `--brand-light: ${product.color}; --brand-dark: ${product.colorDark}` : undefined;
---

<!doctype html>
<html lang="en" data-product={product?.slug} style={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      product ? (
        <link rel="icon" href={product.icon} type="image/webp" />
      ) : (
        <>
          <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
          <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
        </>
      )
    }
    <link rel="apple-touch-icon" href={url(product ? `/products/${product.slug}-180.png` : '/apple-touch-icon.png')} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product ? `${product.name} by ${company.brand}` : company.brand} />
    <meta property="og:title" content={title ?? owner} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, company.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema })} />}
    <script src={url('/site.js')} defer is:inline></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {product ? <ProductHeader product={product} /> : <StudioHeader />}

    <main id="main">
      <slot />
    </main>

    {product ? <ProductFooter product={product} /> : <StudioFooter />}
  </body>
</html>
