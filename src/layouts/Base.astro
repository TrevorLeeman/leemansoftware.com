---
import { url, withoutBase } from '../url';
import '../styles/global.css';
import StudioHeader from '../components/StudioHeader.astro';
import StudioFooter from '../components/StudioFooter.astro';
import ProductHeader from '../components/ProductHeader.astro';
import ProductFooter from '../components/ProductFooter.astro';
import StudioContact from '../components/StudioContact.astro';

import { company, organization, organizationRef, type Product } from '../site';

interface Props {
  title?: string;
  description: string;
  /**
   * Pages of a product's subsite (Wallyt and its policies, the Exchange pages) get the product's
   * own header, footer and colors instead of the studio's.
   */
  product?: Product;
  /** An image for link previews, as a path on this site. Defaults to the product's or the studio's card. */
  image?: string;
  /** Structured data (schema.org) for the thing the page is about, such as the product. */
  schema?: Record<string, unknown>;
  /** The page's own schema.org type, when it's more specific than a WebPage (FAQPage, AboutPage). */
  pageType?: string;
  /** Questions the page answers on screen, repeated for search engines and AI answers. */
  questions?: { q: string; a: string }[];
  /** When the page's content last changed, as YYYY-MM-DD. */
  updated?: string;
  /** Keeps the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description, product, schema, pageType = 'WebPage', questions, updated, noindex } = Astro.props;
const image = Astro.props.image ?? (product ? `/og/${product.slug}.png` : '/og.png');
// The card's own headline, read out where the image can't be seen.
const imageAlt = product ? `${product.name}: ${product.card.join(' ')}` : `${company.brand}: ${company.card.join(' ')}`;
// A subsite's pages are titled for the product ("Terms of use | Wallyt"), or for the studio when
// the title already names the product ("Wallyt privacy policy | Leeman Software"). A title that
// names the studio itself stands alone ("About Trevor Leeman and Leeman Software").
const owner = product ? product.name : company.brand;
const fullTitle = !title
  ? product
    ? owner
    : `${company.brand} | ${company.tagline}`
  : title.includes(company.brand)
    ? title
    : `${title} | ${product && !title.includes(product.name) ? product.name : company.brand}`;
const path = withoutBase(Astro.url.pathname);
const canonical = new URL(path === '/' ? '/' : `${path}/`, company.url).href;

// Search engines and AI answers read the page as one graph: the studio, the site, this page, the
// trail of pages above it, and what the page is about.
const crumbs = [{ name: company.brand, href: `${company.url}/` }];
if (product && path !== '/') crumbs.push({ name: product.name, href: new URL(`/${product.slug}/`, company.url).href });
if (crumbs.at(-1)!.href !== canonical && title) crumbs.push({ name: title, href: canonical });
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    {
      '@type': 'WebSite',
      '@id': `${company.url}/#website`,
      name: company.brand,
      url: `${company.url}/`,
      inLanguage: 'en',
      publisher: organizationRef,
    },
    {
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${company.url}/#website` },
      primaryImageOfPage: new URL(image, company.url).href,
      ...(updated ? { dateModified: updated } : {}),
      ...(crumbs.length > 1 ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
      // A page is about its subject. It's the subject's main page only when the product has no
      // site of its own (Wallyt): osrs.exchange, not this page, is OSRS Exchange's.
      ...(schema
        ? pageType === 'WebPage'
          ? { about: { '@id': `${canonical}#subject` }, ...(product?.site ? {} : { mainEntity: { '@id': `${canonical}#subject` } }) }
          : schema
        : { about: organizationRef }),
    },
    ...(schema && pageType === 'WebPage' ? [{ ...schema, '@id': `${canonical}#subject` }] : []),
    ...(questions?.length
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonical}#questions`,
            url: canonical,
            isPartOf: { '@id': `${canonical}#webpage` },
            mainEntity: questions.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })),
          },
        ]
      : []),
    ...(crumbs.length > 1
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumb`,
            itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.href })),
          },
        ]
      : []),
  ],
};
const theme = product ? `--brand-light: ${product.color}; --brand-dark: ${product.colorDark}` : undefined;
// A product with its own site (the Exchanges) keeps its icon there; until it has one (Wallyt), its
// pages here stand in for that site and use its icon.
const iconOf = product && !product.site ? product : undefined;
---

<!doctype html>
<html lang="en" data-product={product?.slug} style={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <meta name="robots" content="max-image-preview:large, max-snippet:-1" />
        </>
      )
    }
    {
      iconOf ? (
        <link rel="icon" href={iconOf.icon} type="image/webp" />
      ) : (
        <>
          <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
          <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
        </>
      )
    }
    <link rel="apple-touch-icon" href={url(iconOf ? `/products/${iconOf.slug}-180.png` : '/apple-touch-icon.png')} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={product ? `${product.name} by ${company.brand}` : company.brand} />
    <meta property="og:title" content={title ?? owner} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, company.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="alternate" type="text/plain" href={url('/llms.txt')} title="About this site, for AI assistants" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
    <script src={url('/site.js')} defer is:inline></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {product ? <ProductHeader product={product} /> : <StudioHeader />}

    <main id="main">
      <slot />
      <StudioContact />
    </main>

    {product ? <ProductFooter product={product} /> : <StudioFooter />}
  </body>
</html>
