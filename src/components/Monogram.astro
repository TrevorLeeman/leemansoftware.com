---
// The studio mark: an L followed by a thin terminal cursor. On hover it glitches: red and cyan
// copies tear away from it for a moment, then the cursor blinks. The cursor's class is "caret":
// the global .cursor, for the cursor after a headline, would resize it.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" class="mark">
  <rect width="64" height="64" rx="14" fill="var(--mark)"></rect>
  <g class="ghost red">
    <path d="M21 16V45H35" fill="none" stroke="#ff2d55" stroke-width="6.5"></path>
    <rect x="40" y="44.25" width="10" height="4" fill="#ff2d55"></rect>
  </g>
  <g class="ghost cyan">
    <path d="M21 16V45H35" fill="none" stroke="#22d3ee" stroke-width="6.5"></path>
    <rect x="40" y="44.25" width="10" height="4" fill="#22d3ee"></rect>
  </g>
  <g class="main">
    <path d="M21 16V45H35" fill="none" stroke="var(--mark-fg)" stroke-width="6.5"></path>
    <rect class="caret" x="40" y="44.25" width="10" height="4" fill="var(--cursor)"></rect>
  </g>
</svg>

<style>
  .mark {
    flex: none;
    border-radius: 22%;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  /* The copies stay hidden until the glitch shows them. */
  .ghost {
    opacity: 0;
    mix-blend-mode: screen;
  }

  /* Plays only when someone hovers the logo, so the page itself stays still: a glitch straight
     away and every three seconds after, with the cursor blinking in between. */
  :global(a:hover) > .mark .caret {
    animation: blink 1s steps(1) infinite;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .mark .red {
      animation: tear-red 3s steps(1) infinite;
    }

    :global(a:hover) > .mark .cyan {
      animation: tear-cyan 3s steps(1) infinite;
    }

    :global(a:hover) > .mark .main {
      animation: tear-main 3s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes tear-red {
    0% {
      opacity: 1;
      transform: translate(-2.5px, 0.5px);
    }
    2% {
      transform: translate(2px, -1px);
    }
    4% {
      transform: translate(-1px, 0);
    }
    6% {
      transform: translate(3px, 0.5px);
    }
    8%, 100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes tear-cyan {
    0% {
      opacity: 1;
      transform: translate(2.5px, -0.5px);
    }
    2% {
      transform: translate(-2px, 1px);
    }
    4% {
      transform: translate(1.5px, 0);
    }
    6% {
      transform: translate(-3px, -0.5px);
    }
    8%, 100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes tear-main {
    0% {
      transform: translate(1px, 0);
      clip-path: inset(0 0 55% 0);
    }
    2% {
      transform: translate(-1px, 0);
      clip-path: inset(40% 0 0 0);
    }
    4% {
      transform: none;
      clip-path: inset(0 0 20% 0);
    }
    6% {
      transform: translate(1.5px, 0);
      clip-path: inset(30% 0 30% 0);
    }
    8%, 100% {
      transform: none;
      clip-path: none;
    }
  }
</style>
