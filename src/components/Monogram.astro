---
// The studio mark: an L followed by a terminal cursor.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" class="mark">
  <rect width="64" height="64" rx="14" fill="var(--mark)"></rect>
  <path d="M21 16V45H35" fill="none" stroke="var(--mark-fg)" stroke-width="6.5"></path>
  <rect class="cursor" x="40" y="41.75" width="10" height="6.5" fill="var(--cursor)"></rect>
</svg>

<style>
  .mark {
    flex: none;
    border-radius: 22%;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  /* Blinks only when someone hovers the logo, so the page itself stays still. */
  :global(a:hover) > .mark .cursor {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
