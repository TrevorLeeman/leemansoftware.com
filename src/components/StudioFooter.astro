---
// The studio's footer: our products, who we are and how to reach us. Product policies live in each
// product's own footer, not here.
import { url } from '../url';
import { company, email, jagexNotice, products } from '../site';
import Monogram from './Monogram.astro';
import Stamp from './Stamp.astro';
---

<footer class="site-footer">
  <div class="wrap foot">
    <a class="brand" href={url('/')} aria-label={`${company.brand}, home`}>
      <Monogram size={22} />
      <span class="wordmark">Leeman <span>Software</span></span>
    </a>
    <ul class="foot-links">
      {products.map((p) => <li><a href={p.href}>{p.name}</a></li>)}
      <li><a href={url('/about')}>About</a></li>
      <li><a href={url('/privacy')}>Website privacy</a></li>
      <li><a href={`mailto:${email}`}>{email}</a></li>
    </ul>
  </div>

  <div class="wrap">
    <div class="fine">
      <p>
        &copy; {new Date().getFullYear()} {company.legalName}. {company.brand} is its product studio.
        <Stamp />
      </p>
      <p>{jagexNotice}</p>
    </div>
  </div>
</footer>
