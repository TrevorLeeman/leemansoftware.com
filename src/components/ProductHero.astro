---
// The top of a product's subsite: what it is, the one thing to do next, and a real screen.
// Web products stack the text over a wide browser; an app sits beside its phone.
import type { Product } from '../site';
import Screen from './Screen.astro';

interface Props {
  product: Product;
  /** A short line under the name, e.g. "Coming soon to Google Play". */
  status?: string;
}

const { product: p, status } = Astro.props;
const wide = p.shot.frame === 'browser';
---

<section class:list={['hero', { wide }]}>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1 class="title">
        <img class:list={['hero-icon', { pixel: p.pixelIcon }]} src={p.icon} alt="" width="72" height="72" />
        {p.name}
      </h1>
      <p class="lede"><slot name="lede" /></p>
      {status && <p class="status">{status}</p>}
      <div class="actions"><slot name="actions" /></div>
    </div>
    <Screen
      product={p}
      eager
      class="hero-screen"
      href={wide ? p.shot.url : undefined}
      sizes="(min-width: 3000px) 2100px, (min-width: 1100px) min(1400px, 72vw), 100vw"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 9vw, 128px) 0;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }

  .hero h1 {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 20px);
    font-size: clamp(42px, 6.4vw, 80px);
  }

  .hero-icon {
    flex: none;
    width: 0.78em;
    height: 0.78em;
    border-radius: 22%;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .hero-icon.pixel {
    image-rendering: pixelated;
  }

  .hero .lede {
    margin-top: 18px;
  }

  .status {
    margin: 16px 0 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
  }

  .actions:empty {
    display: none;
  }

  .hero-grid > :global(.phone) {
    width: clamp(220px, 24vw, 300px);
  }

  /* A web product: the text centred over the full-width browser. */
  .wide .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(40px, 6vw, 72px);
  }

  .wide .hero-text {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .wide .lede {
    max-width: 40em;
  }

  .wide .actions {
    justify-content: center;
  }

  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .hero-grid > :global(.phone) {
      justify-self: center;
      width: min(280px, 78vw);
    }

    /* Phones read down one left edge, like the sections under the hero. */
    .wide .hero-text {
      justify-items: start;
      text-align: left;
    }

    .wide .actions {
      justify-content: start;
    }
  }
</style>
