---
// What each plan costs and what's in it, side by side, so the price is on the page and not a click
// away. The first plan is the free one.
interface Props {
  plans: { name: string; price: string; note: string; points: string[] }[];
}

const { plans } = Astro.props;
---

<div class="plans">
  {
    plans.map((plan, i) => (
      <section class:list={['plan', { paid: i > 0 }]}>
        <h3>{plan.name}</h3>
        <p class="price">{plan.price}</p>
        <p class="note">{plan.note}</p>
        <ul>
          {plan.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 28px);
  }

  .plan {
    padding: clamp(22px, 2.6vw, 32px);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .paid {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--rule));
  }

  h3 {
    margin: 0;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 450;
    color: var(--muted);
  }

  .price {
    margin: 10px 0 0;
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .note {
    margin: 8px 0 0;
    font-size: 14.5px;
    color: var(--ink-soft);
  }

  ul {
    display: grid;
    gap: 9px;
    margin: 22px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  /* Each line is marked with the logo's cursor. */
  li {
    position: relative;
    padding-left: 20px;
    font-size: 15.5px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  li::before {
    content: '';
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 8px;
    height: 3px;
    background: var(--cursor);
  }

  @media (max-width: 760px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
