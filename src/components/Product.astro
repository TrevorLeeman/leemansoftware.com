---
// One product on the home page: its name, what it does, a link to its subsite, and a real screen.
import type { Product } from '../site';
import Screen from './Screen.astro';

interface Props {
  product: Product;
  /** Puts the screen on the left, so rows alternate down the page. */
  flip?: boolean;
  eager?: boolean;
}

const { product: p, flip = false, eager = false } = Astro.props;
---

<article id={p.slug} class:list={['product', p.shot.frame, { flip }]} style={`--brand: ${p.color}`}>
  <div class="info">
    <h2 class="name">
      <a href={p.href}>
        <img class:list={['icon', { pixel: p.pixelIcon }]} src={p.icon} alt="" width="40" height="40" loading={eager ? 'eager' : 'lazy'} />
        <span>{p.name}</span>
      </a>
    </h2>
    <p class="summary">{p.summary}</p>
    {p.status === 'soon' && <p class="status">Coming soon to Google Play</p>}
    <a class="go" href={p.href}>
      More about {p.name}
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>

  <div class="stage">
    {
      p.shot.frame === 'phone' && p.shot.dark ? (
        // An app shows its light and dark screens side by side, at full height, filling the space a
        // browser would.
        <a class="phones" href={p.href} tabindex="-1" aria-hidden="true">
          <Screen product={p} eager={eager} scheme="light" sizes="280px" />
          <Screen product={p} eager={eager} scheme="dark" decorative sizes="280px" />
        </a>
      ) : (
        <Screen product={p} eager={eager} href={p.href} sizes="(min-width: 3000px) 1500px, (min-width: 900px) 58vw, 100vw" />
      )
    }
  </div>
</article>

<style>
  /*
   * Text and screen hang from one shared top edge, like a caption beside its figure, so the eye
   * reads the name and then drops straight into the screen beside it.
   */
  .product {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: clamp(40px, 5vw, 88px);
  }

  .flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .flip > .stage {
    order: -1;
  }

  .info {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding-top: 8px;
  }

  /*
   * The stage: a soft light in the product's color behind the screen, and a faint grid that fades
   * out around it, so the screen sits in the page's space rather than on top of it.
   */
  .stage {
    position: relative;
    isolation: isolate;
    perspective: 1800px;
  }

  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .stage::before {
    inset: -18% -12%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--brand) 30%, transparent), transparent);
    filter: blur(24px);
    opacity: 0.7;
    transition: opacity 600ms ease;
  }

  .stage::after {
    inset: -12% -8%;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(closest-side, #000 40%, transparent);
    -webkit-mask-image: radial-gradient(closest-side, #000 40%, transparent);
  }

  .product:hover .stage::before {
    opacity: 1;
  }

  .stage :global(.screen) {
    box-shadow: 0 30px 70px -36px rgb(0 0 0 / 0.55);
    transition: border-color 400ms ease;
  }

  .product:hover .stage :global(.screen) {
    border-color: color-mix(in srgb, var(--brand) 55%, var(--rule-strong));
  }

  /* Two phones, the dark one a step lower, so they read as a pair rather than a grid. */
  .phones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 280px));
    align-items: start;
    justify-content: center;
    gap: clamp(20px, 3vw, 40px);
    perspective: 1800px;
  }

  .phones > :global(.phone) {
    width: 100%;
    border-radius: 42px;
  }

  .phones > :global(.phone:last-child) {
    margin-top: clamp(32px, 4vw, 56px);
  }

  .icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    border-radius: 24%;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .icon.pixel {
    image-rendering: pixelated;
  }

  .name {
    margin: 0;
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .name a {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .name a:hover span {
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-decoration-thickness: 2px;
  }

  .summary {
    margin: 0;
    max-width: 30em;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .status {
    margin: 0;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .go svg {
    color: var(--brand);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .go:hover {
    text-decoration: underline;
    text-decoration-color: var(--brand);
  }

  .go:hover svg {
    transform: translateX(3px);
  }

  /*
   * As a screen scrolls into view it starts tipped back, like it's lying on a desk, and stands up
   * to face you by the time it's well on screen. The second phone follows a moment later.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stage :global(.screen) {
        transform-origin: 50% 100%;
        animation: stand-up linear both;
      }

      /* Kept apart from the shorthand above, which would otherwise absorb it and be dropped. */
      .stage :global(.screen:where(*)) {
        animation-timeline: view();
        animation-range: entry 5% entry 85%;
      }

      .stage :global(.phone:last-child:where(*)) {
        animation-range: entry 20% entry 100%;
      }
    }
  }

  @keyframes stand-up {
    from {
      opacity: 0.35;
      transform: rotateX(22deg) scale(0.92) translateY(40px);
    }
  }

  /* Phones and small tablets read top to bottom: what it is, then the screen. */
  @media (max-width: 899px) {
    .product,
    .flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .flip > .stage {
      order: 0;
    }

    .info {
      padding-top: 0;
    }

    .phones {
      justify-content: start;
      gap: 16px;
    }

    .phones > :global(.phone) {
      border-radius: 32px;
    }
  }

  @media (min-width: 1100px) {
    .summary {
      font-size: 17px;
    }
  }
</style>
