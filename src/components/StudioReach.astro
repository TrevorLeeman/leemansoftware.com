---
import { company, players, products } from '../site';
import { url } from '../url';
---

<figure class="reach">
  <div class="reach-top"><span class="label">small studio, real reach</span><span class="key"><i></i> 1 dot ≈ 1,000 players</span></div>
  <div class="audience" aria-hidden="true">
    {Array.from({ length: 500 }, (_, i) => <i style={`--delay: ${(i % 25) * 24}ms; --shade: ${0.28 + ((i * 17) % 70) / 100}`} />)}
  </div>
  <figcaption><strong>{players}</strong><span>players have used OSRS Exchange<br /><small>Lifetime visitors since {company.since}</small></span></figcaption>
  <div class="stem" aria-hidden="true"></div>
  <a class="maker" href={url('/about')}><img src={url('/about/trevor-leeman.webp')} width="44" height="44" alt="" /><span><strong>One person behind it all.</strong><small>{company.founder} · Design, code & everything after</small></span><span class="arrow" aria-hidden="true">↗</span></a>
  <div class="branches" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="product-nodes">{products.map(p => <a href={`#${p.slug}`}><img src={p.icon} width="24" height="24" alt="" /><span>{p.name}</span><small>{p.status === 'live' ? 'Live' : 'In testing'}</small></a>)}</div>
</figure>

<style>
  .reach { margin: 0; padding: clamp(20px, 3vw, 36px); border: 1px solid var(--rule); border-radius: 16px; background: var(--surface); box-shadow: 0 18px 70px -45px #16a34a55; }
  .reach-top { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .label, .key { font-size: 10px; }
  .key { font-family: var(--mono); color: var(--muted); display: flex; align-items: center; gap: 7px; }
  .key i { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .audience { display: grid; grid-template-columns: repeat(25, 1fr); gap: 6px; margin: 25px 0; }
  .audience i { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); opacity: var(--shade); animation: arrive 900ms both; animation-delay: var(--delay); }
  figcaption { display: flex; align-items: center; gap: 20px; }
  figcaption strong { font-size: clamp(32px, 3.5vw, 48px); font-weight: 550; letter-spacing: -.06em; line-height: 1; }
  figcaption span { font-size: 12px; line-height: 1.6; color: var(--ink-soft); }
  figcaption small { font-size: 10px; color: var(--muted); }
  .stem { height: 26px; width: 1px; margin: auto; background: var(--rule-strong); }
  .maker { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1px solid var(--rule-strong); border-radius: 9px; text-decoration: none; }
  .maker img { border-radius: 50%; object-fit: cover; object-position: center 25%; }
  .maker strong { display: block; font-size: 13px; font-weight: 550; }
  .maker small { display: block; font-size: 10px; color: var(--muted); }
  .arrow { margin-left: auto; color: var(--accent); }
  .branches { display: grid; grid-template-columns: repeat(3, 1fr); height: 28px; margin-inline: 16.66%; border-top: 1px solid var(--rule-strong); margin-top: 20px; position: relative; }
  .branches::before { content: ''; position: absolute; width: 1px; height: 20px; background: var(--rule-strong); top: -21px; left: 50%; }
  .branches i { height: 16px; border-left: 1px solid var(--rule-strong); }
  .branches i:nth-child(2) { transform: translateX(50%); }
  .branches i:last-child { border-left: 0; border-right: 1px solid var(--rule-strong); }
  .product-nodes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .product-nodes a { display: grid; justify-items: center; gap: 6px; font-size: 11px; text-decoration: none; }
  .product-nodes a:hover { color: var(--accent); }
  .product-nodes img { border-radius: 6px; }
  .product-nodes small { font: 9px var(--mono); color: var(--muted); }
  @keyframes arrive { from { opacity: 0; transform: translateY(4px); } }
  @media (max-width: 420px) { figcaption { gap: 12px; } figcaption strong { font-size: 34px; } figcaption span { font-size: 10px; } .maker small { font-size: 9px; } }
</style>
